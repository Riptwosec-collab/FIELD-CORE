<stack class="root" onswipe="swipeEvent">
<div if="{{view == 'home'}}" class="page home-page">
  <div class="brand"><text class="brand-main">FIELD CORE</text><text class="brand-sub">FUSION OS</text></div>
  <div class="fusion-panel">
    <div class="fusion-head"><text class="fusion-state">{{fieldState}}</text><text class="mini">{{connectionState}}</text></div>
    <text class="fusion-reason">{{fusionReason}}</text>
    <div class="fusion-line"><text class="label">POWER</text><text class="value">{{powerLabel}}</text></div>
    <div class="fusion-line"><text class="label">ROUTE</text><text class="value small-value">{{routeSummary}}</text></div>
  </div>
  <div class="hud-row">
    <div class="hud-cell"><text class="hud-k">GPS</text><text class="hud-v">{{gpsState}}</text></div>
    <div class="hud-cell"><text class="hud-k">HR</text><text class="hud-v">{{heartRate}}</text></div>
    <div class="hud-cell"><text class="hud-k">ALT</text><text class="hud-v">{{altitude}}</text></div>
    <div class="hud-cell"><text class="hud-k">BAT</text><text class="hud-v">{{watchBattery}}%</text></div>
  </div>
  <div class="env-strip"><text class="env-v">{{weatherTemp}}</text><text class="env-v">{{weatherUV}}</text><text class="env-v">P {{pressure}}</text><text class="env-v">{{headingNameText}}</text></div>
  <div class="quick-row"><input type="button" class="quick" value="ANCHOR" onclick="quickAnchor"/><input type="button" class="quick" value="BREADCRUMB" onclick="quickBreadcrumb"/></div>
  <div class="quick-row"><input type="button" class="quick" value="NAV" onclick="quickNav"/><input type="button" class="quick danger-quick" value="EMERGENCY" onclick="quickEmergency"/></div>
  <div class="cat-row3"><input type="button" class="cat3" value="BIO" onclick="catBio"/><input type="button" class="cat3" value="SPORT" onclick="catSport"/><input type="button" class="cat3" value="NAV" onclick="catNav"/></div>
  <div class="cat-row3"><input type="button" class="cat3" value="ENV" onclick="catEnv"/><input type="button" class="cat3" value="TACT" onclick="catTactical"/><input type="button" class="cat3" value="SYSTEM" onclick="catSystem"/></div>
  <text class="footer">CACHE {{cacheState}} • SYNC {{lastSync}}</text>
</div>

<div if="{{showBio}}" class="page"><div class="topbar"><input type="button" class="back" value="&lt;" onclick="goHome"/><text class="title">BIO</text><text class="mini">{{connectionState}}</text></div><list class="feature-list">
  <list-item class="feature-row"><input type="button" class="feature-btn" value="DAILY HUB" onclick="f0"/><text class="source">WATCH</text></list-item>
  <list-item class="feature-row"><input type="button" class="feature-btn" value="BIO TELEMETRY" onclick="f1"/><text class="source">WATCH</text></list-item>
  <list-item class="feature-row"><input type="button" class="feature-btn" value="SLEEP READINESS" onclick="f2"/><text class="source">PHONE</text></list-item>
  <list-item class="feature-row"><input type="button" class="feature-btn" value="BIO COMBAT" onclick="f3"/><text class="source">WATCH+PHONE</text></list-item>
</list></div>

<div if="{{showSport}}" class="page"><div class="topbar"><input type="button" class="back" value="&lt;" onclick="goHome"/><text class="title">SPORT</text><text class="mini">{{connectionState}}</text></div><list class="feature-list">
  <list-item class="feature-row"><input type="button" class="feature-btn" value="SPORTS HUD" onclick="f4"/><text class="source">WATCH+PHONE</text></list-item>
  <list-item class="feature-row"><input type="button" class="feature-btn" value="RUNNING COACH" onclick="f5"/><text class="source">WATCH+PHONE</text></list-item>
  <list-item class="feature-row"><input type="button" class="feature-btn" value="AQUA RECON" onclick="f6"/><text class="source">WATCH+PHONE</text></list-item>
  <list-item class="feature-row"><input type="button" class="feature-btn" value="GOLF CADDIE" onclick="f7"/><text class="source">PHONE</text></list-item>
</list></div>

<div if="{{showNav}}" class="page"><div class="topbar"><input type="button" class="back" value="&lt;" onclick="goHome"/><text class="title">NAVIGATION</text><text class="mini">{{connectionState}}</text></div><list class="feature-list">
  <list-item class="feature-row"><input type="button" class="feature-btn" value="TACTICAL NAV" onclick="f8"/><text class="source">WATCH+PHONE</text></list-item>
  <list-item class="feature-row"><input type="button" class="feature-btn" value="SILENT NAV" onclick="f9"/><text class="source">PHONE</text></list-item>
  <list-item class="feature-row"><input type="button" class="feature-btn" value="BREADCRUMB 2.0" onclick="f10"/><text class="source">WATCH</text></list-item>
  <list-item class="feature-row"><input type="button" class="feature-btn" value="GEO ANCHOR PRO" onclick="f11"/><text class="source">WATCH</text></list-item>
  <list-item class="feature-row"><input type="button" class="feature-btn" value="TRANSIT GUARDIAN" onclick="f12"/><text class="source">PHONE</text></list-item>
</list></div>

<div if="{{showEnv}}" class="page"><div class="topbar"><input type="button" class="back" value="&lt;" onclick="goHome"/><text class="title">ENVIRONMENT</text><text class="mini">{{weatherState}}</text></div><list class="feature-list">
  <list-item class="feature-row"><input type="button" class="feature-btn" value="ATMOSPHERIC" onclick="f13"/><text class="source">WATCH+PHONE</text></list-item>
  <list-item class="feature-row"><input type="button" class="feature-btn" value="SOLAR SENTINEL" onclick="f14"/><text class="source">PHONE</text></list-item>
  <list-item class="feature-row"><input type="button" class="feature-btn" value="THERMAL LOAD" onclick="f15"/><text class="source">PHONE</text></list-item>
  <list-item class="feature-row"><input type="button" class="feature-btn" value="ALTITUDE SENTINEL" onclick="f16"/><text class="source">WATCH+PHONE</text></list-item>
  <list-item class="feature-row"><input type="button" class="feature-btn" value="SKY SCANNER" onclick="f17"/><text class="source">PHONE</text></list-item>
  <list-item class="feature-row"><input type="button" class="feature-btn" value="ACOUSTIC MONITOR" onclick="f18"/><text class="source">PHONE</text></list-item>
</list></div>

<div if="{{showTactical}}" class="page"><div class="topbar"><input type="button" class="back" value="&lt;" onclick="goHome"/><text class="title">TACTICAL</text><text class="mini">{{powerProfile}}</text></div><list class="feature-list">
  <list-item class="feature-row"><input type="button" class="feature-btn" value="TACTICAL LIGHT" onclick="f19"/><text class="source">WATCH</text></list-item>
  <list-item class="feature-row"><input type="button" class="feature-btn" value="GRID-DOWN" onclick="f20"/><text class="source">WATCH</text></list-item>
  <list-item class="feature-row"><input type="button" class="feature-btn" value="EMERGENCY CORE PRO" onclick="f21"/><text class="source">WATCH+PHONE</text></list-item>
  <list-item class="feature-row"><input type="button" class="feature-btn" value="DEPTH HUD" onclick="f22"/><text class="source">API GATED</text></list-item>
</list></div>

<div if="{{showSystem}}" class="page"><div class="topbar"><input type="button" class="back" value="&lt;" onclick="goHome"/><text class="title">SYSTEM</text><text class="mini">{{powerLabel}}</text></div><list class="feature-list">
  <list-item class="feature-row"><input type="button" class="feature-btn" value="LIGHT GUARDIAN" onclick="f23"/><text class="source">API GATED</text></list-item>
  <list-item class="feature-row"><input type="button" class="feature-btn" value="POWER COMMANDER 2.0" onclick="f24"/><text class="source">WATCH</text></list-item>
  <list-item class="feature-row"><input type="button" class="feature-btn" value="MOTION COMMAND" onclick="f25"/><text class="source">WATCH</text></list-item>
  <list-item class="feature-row"><input type="button" class="feature-btn" value="VOICE COMMAND 2.0" onclick="f26"/><text class="source">PHONE</text></list-item>
  <list-item class="feature-row"><input type="button" class="feature-btn" value="DEVICE ACCESS" onclick="f27"/><text class="source">WATCH+PHONE</text></list-item>
</list></div>

<div if="{{view == 'detail'}}" class="page detail-page">
  <div class="topbar"><input type="button" class="back" value="&lt;" onclick="goList"/><text class="title">{{selectedTitle}}</text><text class="mini">{{selectedSource}}</text></div>
  <div class="detail-card"><text class="detail-desc">{{selectedDesc}}</text><div class="metric-row"><text class="label">STATE</text><text class="ok">{{featureState}}</text></div><div class="metric-row"><text class="label">DATA</text><text class="value small-value">{{featureData}}</text></div></div>
  <input if="{{action1Label != ''}}" type="button" class="action" value="{{action1Label}}" onclick="detailAction1"/>
  <input if="{{action2Label != ''}}" type="button" class="action" value="{{action2Label}}" onclick="detailAction2"/>
  <input if="{{action3Label != ''}}" type="button" class="action" value="{{action3Label}}" onclick="detailAction3"/>
  <input if="{{action4Label != ''}}" type="button" class="action danger" value="{{action4Label}}" onclick="detailAction4"/>
  <div if="{{selectedId == '10'}}" class="special-row"><input type="button" class="special" value="NEW ROUTE" onclick="newBreadcrumb"/><input type="button" class="special" value="STOP RETURN" onclick="stopReturn"/></div>
  <div if="{{selectedId == '21'}}" class="special-row"><input type="button" class="special" value="{{impactButtonLabel}}" onclick="toggleImpactAssist"/><input type="button" class="special danger" value="COUNTDOWN" onclick="startEmergencyCountdown"/></div>
  <input if="{{selectedId == '24'}}" type="button" class="special-wide" value="AUTO POWER" onclick="enableAutoPower"/>
  <input if="{{selectedId == '27'}}" type="button" class="special-wide" value="CAPABILITY MATRIX" onclick="openCapabilities"/>
  <text class="message">{{message}}</text>
</div>

<div if="{{view == 'anchors'}}" class="page">
  <div class="topbar"><input type="button" class="back" value="&lt;" onclick="goHome"/><text class="title">GEO ANCHORS</text><text class="mini">{{anchorsCount}} / 20</text></div>
  <div class="anchor-row"><div class="anchor-copy"><text class="anchor-name">{{anchor1}}</text><text class="anchor-meta">{{anchor1Meta}}</text></div><input type="button" class="anchor-go" value="RETURN" onclick="anchor1Return"/></div>
  <div class="anchor-row"><div class="anchor-copy"><text class="anchor-name">{{anchor2}}</text><text class="anchor-meta">{{anchor2Meta}}</text></div><input type="button" class="anchor-go" value="RETURN" onclick="anchor2Return"/></div>
  <div class="anchor-row"><div class="anchor-copy"><text class="anchor-name">{{anchor3}}</text><text class="anchor-meta">{{anchor3Meta}}</text></div><input type="button" class="anchor-go" value="RETURN" onclick="anchor3Return"/></div>
  <div class="anchor-row"><div class="anchor-copy"><text class="anchor-name">{{anchor4}}</text><text class="anchor-meta">{{anchor4Meta}}</text></div><input type="button" class="anchor-go" value="RETURN" onclick="anchor4Return"/></div>
  <div class="pager"><input type="button" class="special" value="PREV" onclick="anchorPrev"/><input type="button" class="special" value="NEXT" onclick="anchorNext"/></div>
  <div class="pager"><input type="button" class="special" value="SAVE NEW" onclick="detailAction1"/><input type="button" class="special danger" value="DELETE LAST" onclick="deleteLastAnchor"/></div>
</div>

<div if="{{view == 'timeline'}}" class="page">
  <div class="topbar"><input type="button" class="back" value="&lt;" onclick="goHome"/><text class="title">MISSION TIMELINE</text><text class="mini">LOCAL</text></div>
  <div class="timeline-card"><text class="timeline-line">{{timeline1}}</text></div>
  <div class="timeline-card"><text class="timeline-line">{{timeline2}}</text></div>
  <div class="timeline-card"><text class="timeline-line">{{timeline3}}</text></div>
  <div class="timeline-card"><text class="timeline-line">{{timeline4}}</text></div>
  <div class="pager"><input type="button" class="special" value="NEWER" onclick="timelineNewer"/><input type="button" class="special" value="OLDER" onclick="timelineOlder"/></div>
  <input type="button" class="special-wide danger" value="CLEAR TIMELINE" onclick="clearTimeline"/>
</div>

<div if="{{view == 'capabilities'}}" class="page">
  <div class="topbar"><input type="button" class="back" value="&lt;" onclick="goHome"/><text class="title">DEVICE ACCESS</text><text class="mini">REAL ONLY</text></div>
  <div class="cap-card"><text class="cap-text">{{capabilityText}}</text></div>
  <input type="button" class="special-wide" value="REFRESH PHONE STATUS" onclick="detailAction1"/>
  <input type="button" class="special-wide" value="SYNC" onclick="detailAction2"/>
</div>

<div if="{{view == 'emergencyConfirm'}}" class="emergency-screen">
  <text class="emergency-title">CHECK USER</text><text class="emergency-sub">HIGH IMPACT / SOS</text><text class="countdown">{{emergencyCountdown}}</text><text class="emergency-sub">SEND LOCATION WHEN TIMER ENDS</text>
  <input type="button" class="emergency-send" value="SEND NOW" onclick="sendEmergencyNow"/><input type="button" class="emergency-cancel" value="I'M OK / CANCEL" onclick="cancelEmergency"/>
</div>

<div if="{{view == 'lightRed'}}" class="light-red"><text class="light-title">TACTICAL RED</text><text class="light-sub">FIELD LIGHT</text><input type="button" class="light-stop" value="STOP" onclick="stopLight"/></div>
<div if="{{view == 'lightWhite'}}" class="light-white"><text class="light-title dark-text">WHITE LIGHT</text><text class="light-sub dark-text">FIELD LIGHT</text><input type="button" class="light-stop" value="STOP" onclick="stopLight"/></div>
<div if="{{view == 'lightBlack'}}" class="light-black"><text class="light-title red-text">SOS</text><text class="light-sub red-text">FLASHING</text><input type="button" class="light-stop" value="STOP SOS" onclick="stopLight"/></div>
</stack>
