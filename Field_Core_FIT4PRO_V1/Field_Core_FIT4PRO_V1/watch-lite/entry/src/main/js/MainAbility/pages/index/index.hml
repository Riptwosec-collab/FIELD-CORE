<stack class="root" onswipe="swipeEvent">
<div if="{{view == 'home'}}" class="page">
  <div class="brand"><text class="brand-main">FIELD CORE</text><text class="brand-sub">FIT 4 PRO</text></div>
  <div class="status-panel">
    <div class="status-row"><text class="label">PHONE</text><text class="ok">{{connectionState}}</text></div>
    <div class="status-row"><text class="label">BATTERY</text><text class="value">{{watchBattery}}%</text></div>
    <div class="status-row"><text class="label">HR</text><text class="value">{{heartRate}} BPM</text></div>
    <div class="status-row"><text class="label">FIELD</text><text class="value">{{fieldState}}</text></div>
  </div>
  <div class="quick-row"><input type="button" class="quick" value="ANCHOR" onclick="quickAnchor"/><input type="button" class="quick" value="BREADCRUMB" onclick="quickBreadcrumb"/></div>
  <div class="quick-row"><input type="button" class="quick" value="NAV" onclick="quickNav"/><input type="button" class="quick danger-quick" value="EMERGENCY" onclick="quickEmergency"/></div>
  <div class="cat-row"><input type="button" class="cat" value="BIO" onclick="catBio"/><input type="button" class="cat" value="SPORT" onclick="catSport"/></div>
  <div class="cat-row"><input type="button" class="cat" value="NAV" onclick="catNav"/><input type="button" class="cat" value="ENV" onclick="catEnv"/></div>
  <div class="cat-row"><input type="button" class="cat" value="TACTICAL" onclick="catTactical"/><input type="button" class="cat" value="SYSTEM" onclick="catSystem"/></div>
  <text class="footer">28 MODULES • LOCAL FIRST • REAL DATA ONLY</text>
</div>
<div if="{{showBio}}" class="page"><div class="topbar"><input type="button" class="back" value="&lt;" onclick="goHome"/><text class="title">BIO</text><text class="mini">{{connectionState}}</text></div><list class="feature-list"><list-item class="feature-row"><input type="button" class="feature-btn" value="DAILY HUB" onclick="f0"/><text class="source">WATCH</text></list-item><list-item class="feature-row"><input type="button" class="feature-btn" value="BIO TELEMETRY" onclick="f1"/><text class="source">WATCH</text></list-item><list-item class="feature-row"><input type="button" class="feature-btn" value="SLEEP READINESS" onclick="f2"/><text class="source">PHONE</text></list-item><list-item class="feature-row"><input type="button" class="feature-btn" value="BIO COMBAT" onclick="f3"/><text class="source">WATCH+PHONE</text></list-item></list></div>
<div if="{{showSport}}" class="page"><div class="topbar"><input type="button" class="back" value="&lt;" onclick="goHome"/><text class="title">SPORT</text><text class="mini">{{connectionState}}</text></div><list class="feature-list"><list-item class="feature-row"><input type="button" class="feature-btn" value="SPORTS HUD" onclick="f4"/><text class="source">PHONE</text></list-item><list-item class="feature-row"><input type="button" class="feature-btn" value="RUNNING COACH" onclick="f5"/><text class="source">PHONE</text></list-item><list-item class="feature-row"><input type="button" class="feature-btn" value="AQUA RECON" onclick="f6"/><text class="source">PHONE</text></list-item><list-item class="feature-row"><input type="button" class="feature-btn" value="GOLF CADDIE" onclick="f7"/><text class="source">PHONE</text></list-item></list></div>
<div if="{{showNav}}" class="page"><div class="topbar"><input type="button" class="back" value="&lt;" onclick="goHome"/><text class="title">NAVIGATION</text><text class="mini">{{connectionState}}</text></div><list class="feature-list"><list-item class="feature-row"><input type="button" class="feature-btn" value="TACTICAL NAV" onclick="f8"/><text class="source">WATCH+PHONE</text></list-item><list-item class="feature-row"><input type="button" class="feature-btn" value="SILENT NAV" onclick="f9"/><text class="source">PHONE</text></list-item><list-item class="feature-row"><input type="button" class="feature-btn" value="BREADCRUMB" onclick="f10"/><text class="source">WATCH</text></list-item><list-item class="feature-row"><input type="button" class="feature-btn" value="GEO ANCHOR" onclick="f11"/><text class="source">WATCH</text></list-item><list-item class="feature-row"><input type="button" class="feature-btn" value="TRANSIT GUARDIAN" onclick="f12"/><text class="source">PHONE</text></list-item></list></div>
<div if="{{showEnv}}" class="page"><div class="topbar"><input type="button" class="back" value="&lt;" onclick="goHome"/><text class="title">ENVIRONMENT</text><text class="mini">{{connectionState}}</text></div><list class="feature-list"><list-item class="feature-row"><input type="button" class="feature-btn" value="ATMOSPHERIC" onclick="f13"/><text class="source">WATCH+PHONE</text></list-item><list-item class="feature-row"><input type="button" class="feature-btn" value="SOLAR SENTINEL" onclick="f14"/><text class="source">PHONE</text></list-item><list-item class="feature-row"><input type="button" class="feature-btn" value="THERMAL LOAD" onclick="f15"/><text class="source">PHONE</text></list-item><list-item class="feature-row"><input type="button" class="feature-btn" value="ALTITUDE SENTINEL" onclick="f16"/><text class="source">WATCH+PHONE</text></list-item><list-item class="feature-row"><input type="button" class="feature-btn" value="SKY SCANNER" onclick="f17"/><text class="source">PHONE</text></list-item><list-item class="feature-row"><input type="button" class="feature-btn" value="ACOUSTIC MONITOR" onclick="f18"/><text class="source">PHONE</text></list-item></list></div>
<div if="{{showTactical}}" class="page"><div class="topbar"><input type="button" class="back" value="&lt;" onclick="goHome"/><text class="title">TACTICAL</text><text class="mini">{{connectionState}}</text></div><list class="feature-list"><list-item class="feature-row"><input type="button" class="feature-btn" value="TACTICAL LIGHT" onclick="f19"/><text class="source">WATCH</text></list-item><list-item class="feature-row"><input type="button" class="feature-btn" value="GRID-DOWN" onclick="f20"/><text class="source">WATCH</text></list-item><list-item class="feature-row"><input type="button" class="feature-btn" value="EMERGENCY CORE" onclick="f21"/><text class="source">WATCH+PHONE</text></list-item><list-item class="feature-row"><input type="button" class="feature-btn" value="DEPTH HUD" onclick="f22"/><text class="source">UNAVAILABLE</text></list-item></list></div>
<div if="{{showSystem}}" class="page"><div class="topbar"><input type="button" class="back" value="&lt;" onclick="goHome"/><text class="title">SYSTEM</text><text class="mini">{{connectionState}}</text></div><list class="feature-list"><list-item class="feature-row"><input type="button" class="feature-btn" value="LIGHT GUARDIAN" onclick="f23"/><text class="source">UNAVAILABLE</text></list-item><list-item class="feature-row"><input type="button" class="feature-btn" value="POWER COMMANDER" onclick="f24"/><text class="source">WATCH</text></list-item><list-item class="feature-row"><input type="button" class="feature-btn" value="MOTION COMMAND" onclick="f25"/><text class="source">WATCH</text></list-item><list-item class="feature-row"><input type="button" class="feature-btn" value="VOICE COMMAND" onclick="f26"/><text class="source">PHONE</text></list-item><list-item class="feature-row"><input type="button" class="feature-btn" value="DEVICE ACCESS" onclick="f27"/><text class="source">WATCH+PHONE</text></list-item></list></div>
<div if="{{view == 'detail'}}" class="page detail-page">
  <div class="topbar"><input type="button" class="back" value="&lt;" onclick="goList"/><text class="title">{{selectedTitle}}</text><text class="mini">{{selectedSource}}</text></div>
  <div class="detail-card">
    <text class="detail-desc">{{selectedDesc}}</text>
    <div class="metric-row"><text class="label">STATE</text><text class="ok">{{featureState}}</text></div>
    <div class="metric-row"><text class="label">DATA</text><text class="value small-value">{{featureData}}</text></div>
  </div>
  <input if="{{action1Label != ''}}" type="button" class="action" value="{{action1Label}}" onclick="detailAction1"/>
  <input if="{{action2Label != ''}}" type="button" class="action" value="{{action2Label}}" onclick="detailAction2"/>
  <input if="{{action3Label != ''}}" type="button" class="action" value="{{action3Label}}" onclick="detailAction3"/>
  <input if="{{action4Label != ''}}" type="button" class="action danger" value="{{action4Label}}" onclick="detailAction4"/>
  <text class="message">{{message}}</text>
</div>
<div if="{{view == 'lightRed'}}" class="light-red"><text class="light-title">TACTICAL RED</text><text class="light-sub">FIELD LIGHT</text><input type="button" class="light-stop" value="STOP" onclick="stopLight"/></div>
<div if="{{view == 'lightWhite'}}" class="light-white"><text class="light-title dark-text">WHITE LIGHT</text><text class="light-sub dark-text">FIELD LIGHT</text><input type="button" class="light-stop" value="STOP" onclick="stopLight"/></div>
<div if="{{view == 'lightBlack'}}" class="light-black"><text class="light-title red-text">SOS</text><text class="light-sub red-text">FLASHING</text><input type="button" class="light-stop" value="STOP SOS" onclick="stopLight"/></div>
</stack>
