<stack class="root" onswipe="swipeEvent">
  <!-- FIELD CORE VISUAL V4: DISTINCT ALL-PAGE MASTERPIECE -->
  <div class="grid-layer"></div>
  <div if="{{powerProfile != 'ENDURANCE'}}" class="scan-beam"></div>

  <div if="{{view == 'home'}}" class="page masterpiece-page page-enter">
    <div class="system-status-strip">
      <div class="status-cell"><text class="status-dot online">●</text><text class="status-label">CORE</text></div>
      <div class="status-cell"><text class="status-dot online">●</text><text class="status-label">LINK</text></div>
      <div class="status-cell"><text class="status-dot online">●</text><text class="status-label">CACHE</text></div>
      <text class="battery-mini">{{watchBattery}}%</text>
    </div>

    <div class="header">
      <div class="home-clock"><text class="time-display">FIELD CORE</text><text class="clock-meta">{{lastSync}}</text></div>
      <div class="status-area"><text class="status-title">STATUS</text><text class="status-secure">{{connectionState}}</text></div>
    </div>

    <div class="page-header home-header">
      <text class="page-title">FIELD CORE</text>
      <div class="subtitle-row"><div class="subtitle-line pulse-line"></div><text class="page-subtitle">FUSION OS</text><div class="subtitle-line pulse-line"></div></div>
    </div>

    <div class="telemetry-strip">
      <div class="telemetry-cell"><text class="telemetry-k">GPS</text><text class="telemetry-v">{{gpsState}}</text></div>
      <div class="telemetry-cell"><text class="telemetry-k">HR</text><text class="telemetry-v">{{heartRate}}</text></div>
      <div class="telemetry-cell"><text class="telemetry-k">ALT</text><text class="telemetry-v">{{altitude}}</text></div>
      <div class="telemetry-cell wide"><text class="telemetry-k">ROUTE</text><text class="telemetry-v tiny-v">{{routeSummary}}</text></div>
    </div>

    <div class="volume-panel">
      <div if="{{powerProfile != 'ENDURANCE'}}" class="dial-pulse-ring"></div>
      <div class="volume-dial">
        <div class="volume-ticks"></div>
        <div class="volume-active-clip"><div class="volume-active-ring"></div></div>
        <div class="volume-core">
          <text class="dial-home-state">{{fieldState}}</text>
          <text class="dial-home-value">{{watchBattery}}%</text>
          <text class="dial-home-note">{{fusionReason}}</text>
        </div>
      </div>
      <div if="{{powerProfile != 'ENDURANCE'}}" class="dial-sweep"></div>
    </div>

    <div class="eq-row">
      <div class="eq-bar eq1"></div><div class="eq-bar eq2"></div><div class="eq-bar eq3"></div><div class="eq-bar eq4"></div>
      <div class="eq-bar eq5"></div><div class="eq-bar eq6"></div><div class="eq-bar eq7"></div>
    </div>

    <div class="grid-2 primary-grid">
      <input type="button" class="btn-cyber active-state pulse-btn" value="ANCHOR" onclick="quickAnchor"/>
      <input type="button" class="btn-cyber" value="BREADCRUMB" onclick="quickBreadcrumb"/>
    </div>

    <div class="favorite-label"><text class="section-lbl">● FIELD QUICK ACTIONS</text><text class="mini-state">{{powerLabel}} • WIFI {{wifiCount}}</text></div>
    <div class="grid-2 macro-grid"><input type="button" class="macro-btn" value="NAV" onclick="quickNav"/><input type="button" class="macro-btn danger-lite" value="EMERGENCY" onclick="quickEmergency"/></div>

    <div class="dock-wrapper">
      <div class="dock-scroll">
        <input type="button" class="dock-item active" value="★" onclick="goHome"/>
        <input type="button" class="dock-item" value="BIO" onclick="catBio"/>
        <input type="button" class="dock-item" value="RUN" onclick="catSport"/>
        <input type="button" class="dock-item" value="NAV" onclick="catNav"/>
        <input type="button" class="dock-item" value="ENV" onclick="catEnv"/>
        <input type="button" class="dock-item" value="TAC" onclick="catTactical"/>
        <input type="button" class="dock-item" value="SYS" onclick="catSystem"/>
        <input type="button" class="dock-item" value="CMD" onclick="openCommandCenter"/>
        <input type="button" class="dock-item" value="REC" onclick="openReconHub"/>
      </div>
    </div>
  </div>

  <div if="{{showBio}}" class="page masterpiece-page bio-page-v4 page-enter">
    <div class="system-status-strip">
      <div class="status-cell"><text class="status-dot online">●</text><text class="status-label">CORE</text></div>
      <div class="status-cell"><text class="status-dot online">●</text><text class="status-label">BIO</text></div>
      <text class="status-label">{{impactButtonLabel}}</text><text class="battery-mini">{{watchBattery}}%</text>
    </div>
    <div class="header"><input type="button" class="back-cyber" value="‹" onclick="goHome"/><div class="status-area"><text class="status-title">PHONE</text><text class="status-secure">{{connectionState}}</text></div></div>
    <div class="page-header compact-header"><text class="page-title">BIO</text><div class="subtitle-row"><div class="subtitle-line pulse-line"></div><text class="page-subtitle">BIO TELEMETRY</text><div class="subtitle-line pulse-line"></div></div></div>

    <div class="category-hero">
      <div class="bio-orbit">
        <div if="{{powerProfile != 'ENDURANCE'}}" class="bio-pulse-ring bpr1"></div>
        <div if="{{powerProfile != 'ENDURANCE'}}" class="bio-pulse-ring bpr2"></div>
        <div class="bio-core"><text class="bio-value">{{heartRate}}</text><text class="bio-unit">BPM</text></div>
      </div>
      <div class="hero-copy"><text class="hero-k">LOCAL BIO CORE</text><text class="hero-v">{{featureState}}</text><text class="hero-sub">REAL SENSOR • WELLNESS</text></div>
    </div>

    <div class="signal-strip">
      <div class="signal-cell"><text class="signal-k">HR</text><text class="signal-v">{{heartRate}} BPM</text></div>
      <div class="signal-cell"><text class="signal-k">FIELD</text><text class="signal-v">{{fieldState}}</text></div>
      <div class="signal-cell"><text class="signal-k">HEALTH</text><text class="signal-v warning-text">SCOPE GATED</text></div>
    </div>

    <list class="feature-list short-list">
      <list-item class="feature-row"><input type="button" class="feature-btn" value="DAILY HUB" onclick="f0"/><text class="source">WATCH</text></list-item>
      <list-item class="feature-row"><input type="button" class="feature-btn" value="BIO TELEMETRY" onclick="f1"/><text class="source">WATCH</text></list-item>
      <list-item class="feature-row"><input type="button" class="feature-btn" value="SLEEP READINESS" onclick="f2"/><text class="source">PHONE</text></list-item>
      <list-item class="feature-row"><input type="button" class="feature-btn" value="BIO COMBAT" onclick="f3"/><text class="source">WATCH+PHONE</text></list-item>
    </list>
    <div class="category-dock"><input type="button" class="dock-item active" value="BIO" onclick="catBio"/><input type="button" class="dock-item" value="RUN" onclick="catSport"/><input type="button" class="dock-item" value="NAV" onclick="catNav"/><input type="button" class="dock-item" value="ENV" onclick="catEnv"/><input type="button" class="dock-item" value="TAC" onclick="catTactical"/><input type="button" class="dock-item" value="SYS" onclick="catSystem"/></div>
  </div>

  <div if="{{showSport}}" class="page masterpiece-page sport-page-v4 page-enter">
    <div class="system-status-strip"><div class="status-cell"><text class="status-dot online">●</text><text class="status-label">CORE</text></div><div class="status-cell"><text class="status-dot online">●</text><text class="status-label">SPORT</text></div><text class="status-label">GPS {{gpsState}}</text><text class="battery-mini">{{watchBattery}}%</text></div>
    <div class="header"><input type="button" class="back-cyber" value="‹" onclick="goHome"/><div class="status-area"><text class="status-title">STATUS</text><text class="status-secure">{{connectionState}}</text></div></div>
    <div class="page-header compact-header"><text class="page-title">SPORT</text><div class="subtitle-row"><div class="subtitle-line pulse-line"></div><text class="page-subtitle">PERFORMANCE HUD</text><div class="subtitle-line pulse-line"></div></div></div>

    <div class="sport-stage">
      <div class="sport-ring"><div class="sport-ring-inner"><text class="sport-value">{{speedKmh}}</text><text class="sport-unit">KM/H</text></div></div>
      <div class="sport-data">
        <div class="sport-row"><text class="module-k">HR</text><text class="module-v">{{heartRate}} BPM</text></div>
        <div class="sport-row"><text class="module-k">ALT</text><text class="module-v">{{altitude}}</text></div>
        <div class="sport-row"><text class="module-k">ROUTE</text><text class="module-v">{{breadcrumbPoints}} PTS</text></div>
        <div class="sport-row"><text class="module-k">POWER</text><text class="module-v">{{powerProfile}}</text></div>
      </div>
    </div>

    <div class="eq-row sport-eq"><div class="eq-bar eq2"></div><div class="eq-bar eq5"></div><div class="eq-bar eq3"></div><div class="eq-bar eq6"></div><div class="eq-bar eq4"></div><div class="eq-bar eq1"></div><div class="eq-bar eq7"></div></div>

    <list class="feature-list short-list sport-list">
      <list-item class="feature-row"><input type="button" class="feature-btn" value="SPORTS HUD" onclick="f4"/><text class="source">WATCH+PHONE</text></list-item>
      <list-item class="feature-row"><input type="button" class="feature-btn" value="RUNNING COACH" onclick="f5"/><text class="source">WATCH+PHONE</text></list-item>
      <list-item class="feature-row"><input type="button" class="feature-btn" value="AQUA RECON" onclick="f6"/><text class="source">WATCH+PHONE</text></list-item>
      <list-item class="feature-row"><input type="button" class="feature-btn" value="GOLF CADDIE" onclick="f7"/><text class="source">PHONE</text></list-item>
    </list>
    <div class="category-dock"><input type="button" class="dock-item" value="BIO" onclick="catBio"/><input type="button" class="dock-item active" value="RUN" onclick="catSport"/><input type="button" class="dock-item" value="NAV" onclick="catNav"/><input type="button" class="dock-item" value="ENV" onclick="catEnv"/><input type="button" class="dock-item" value="TAC" onclick="catTactical"/><input type="button" class="dock-item" value="SYS" onclick="catSystem"/></div>
  </div>

  <div if="{{showNav}}" class="page masterpiece-page nav-page-v4 page-enter">
    <div class="system-status-strip"><div class="status-cell"><text class="status-dot online">●</text><text class="status-label">CORE</text></div><div class="status-cell"><text class="status-dot online">●</text><text class="status-label">NAV</text></div><text class="status-label">ROUTE {{breadcrumbPoints}}</text><text class="battery-mini">{{watchBattery}}%</text></div>
    <div class="header"><input type="button" class="back-cyber" value="‹" onclick="goHome"/><div class="status-area"><text class="status-title">GPS</text><text class="status-secure">{{gpsState}}</text></div></div>
    <div class="page-header compact-header"><text class="page-title">NAV</text><div class="subtitle-row"><div class="subtitle-line pulse-line"></div><text class="page-subtitle">TACTICAL NAVIGATION</text><div class="subtitle-line pulse-line"></div></div></div>

    <div class="nav-stage">
      <div class="network-radar">
        <div class="radar-ring r1"></div><div class="radar-ring r2"></div><div class="radar-ring r3"></div>
        <div if="{{powerProfile != 'ENDURANCE'}}" class="radar-sweep"></div>
        <div class="radar-core"><text class="radar-value">{{heading}}</text><text class="radar-label">{{headingNameText}}</text></div>
      </div>
      <div class="nav-side">
        <div class="module-stat"><text class="module-k">GPS</text><text class="module-v">{{gpsState}}</text></div>
        <div class="module-stat"><text class="module-k">RETURN</text><text class="module-v">{{returning}}</text></div>
        <div class="module-stat"><text class="module-k">SPEED</text><text class="module-v">{{speedKmh}} KM/H</text></div>
        <div class="module-stat"><text class="module-k">ALT</text><text class="module-v">{{altitude}}</text></div>
      </div>
    </div>

    <list class="feature-list nav-list">
      <list-item class="feature-row"><input type="button" class="feature-btn" value="TACTICAL NAV" onclick="f8"/><text class="source">WATCH+PHONE</text></list-item>
      <list-item class="feature-row"><input type="button" class="feature-btn" value="SILENT NAV" onclick="f9"/><text class="source">PHONE</text></list-item>
      <list-item class="feature-row"><input type="button" class="feature-btn" value="BREADCRUMB" onclick="f10"/><text class="source">WATCH</text></list-item>
      <list-item class="feature-row"><input type="button" class="feature-btn" value="GEO ANCHOR" onclick="f11"/><text class="source">WATCH</text></list-item>
      <list-item class="feature-row"><input type="button" class="feature-btn" value="TRANSIT GUARDIAN" onclick="f12"/><text class="source">PHONE</text></list-item>
    </list>
    <div class="category-dock"><input type="button" class="dock-item" value="BIO" onclick="catBio"/><input type="button" class="dock-item" value="RUN" onclick="catSport"/><input type="button" class="dock-item active" value="NAV" onclick="catNav"/><input type="button" class="dock-item" value="ENV" onclick="catEnv"/><input type="button" class="dock-item" value="TAC" onclick="catTactical"/><input type="button" class="dock-item" value="SYS" onclick="catSystem"/></div>
  </div>

  <div if="{{showEnv}}" class="page masterpiece-page env-page-v4 page-enter">
    <div class="system-status-strip"><div class="status-cell"><text class="status-dot online">●</text><text class="status-label">CORE</text></div><div class="status-cell"><text class="status-dot online">●</text><text class="status-label">ENV</text></div><text class="status-label">{{weatherState}}</text><text class="battery-mini">{{watchBattery}}%</text></div>
    <div class="header"><input type="button" class="back-cyber" value="‹" onclick="goHome"/><div class="status-area"><text class="status-title">CACHE</text><text class="status-secure">{{cacheState}}</text></div></div>
    <div class="page-header compact-header"><text class="page-title">ENV</text><div class="subtitle-row"><div class="subtitle-line pulse-line"></div><text class="page-subtitle">ATMOSPHERIC INTELLIGENCE</text><div class="subtitle-line pulse-line"></div></div></div>

    <div class="env-stage">
      <div class="atmo-dial">
        <div if="{{powerProfile != 'ENDURANCE'}}" class="atmo-sweep"></div>
        <div class="atmo-core"><text class="atmo-temp">{{weatherTemp}}</text><text class="atmo-state">{{pressureTrend}}</text></div>
      </div>
      <div class="env-side">
        <div class="module-stat"><text class="module-k">PRESSURE</text><text class="module-v">{{pressure}} hPa</text></div>
        <div class="module-stat"><text class="module-k">UV</text><text class="module-v">{{weatherUV}}</text></div>
        <div class="module-stat"><text class="module-k">SUNSET</text><text class="module-v">{{weatherSun}}</text></div>
        <div class="module-stat"><text class="module-k">ALT</text><text class="module-v">{{altitude}}</text></div>
      </div>
    </div>

    <list class="feature-list env-list">
      <list-item class="feature-row"><input type="button" class="feature-btn" value="ATMOSPHERIC" onclick="f13"/><text class="source">WATCH+PHONE</text></list-item>
      <list-item class="feature-row"><input type="button" class="feature-btn" value="SOLAR SENTINEL" onclick="f14"/><text class="source">PHONE</text></list-item>
      <list-item class="feature-row"><input type="button" class="feature-btn" value="THERMAL LOAD" onclick="f15"/><text class="source">PHONE</text></list-item>
      <list-item class="feature-row"><input type="button" class="feature-btn" value="ALTITUDE SENTINEL" onclick="f16"/><text class="source">WATCH+PHONE</text></list-item>
      <list-item class="feature-row"><input type="button" class="feature-btn" value="SKY SCANNER" onclick="f17"/><text class="source">PHONE</text></list-item>
      <list-item class="feature-row"><input type="button" class="feature-btn" value="ACOUSTIC MONITOR" onclick="f18"/><text class="source">PHONE</text></list-item>
    </list>
    <div class="category-dock"><input type="button" class="dock-item" value="BIO" onclick="catBio"/><input type="button" class="dock-item" value="RUN" onclick="catSport"/><input type="button" class="dock-item" value="NAV" onclick="catNav"/><input type="button" class="dock-item active" value="ENV" onclick="catEnv"/><input type="button" class="dock-item" value="TAC" onclick="catTactical"/><input type="button" class="dock-item" value="SYS" onclick="catSystem"/></div>
  </div>

  <div if="{{showTactical}}" class="page masterpiece-page tactical-page tactical-page-v4 page-enter">
    <div class="system-status-strip"><div class="status-cell"><text class="status-dot danger-dot">●</text><text class="status-label">CORE</text></div><div class="status-cell"><text class="status-dot danger-dot">●</text><text class="status-label">TACTICAL</text></div><text class="status-label">{{impactButtonLabel}}</text><text class="battery-mini">{{watchBattery}}%</text></div>
    <div class="header"><input type="button" class="back-cyber tactical-back" value="‹" onclick="goHome"/><div class="status-area"><text class="status-title">POWER</text><text class="status-danger">{{powerProfile}}</text></div></div>
    <div class="page-header compact-header"><text class="page-title">TACTICAL</text><div class="subtitle-row"><div class="subtitle-line danger-line"></div><text class="page-subtitle danger-sub">OFFLINE / EMERGENCY CORE</text><div class="subtitle-line danger-line"></div></div></div>

    <div class="tactical-hero">
      <div class="crosshair"><div class="cross-h"></div><div class="cross-v"></div><div class="cross-core"></div><div if="{{powerProfile != 'ENDURANCE'}}" class="cross-pulse"></div></div>
      <div class="tactical-copy"><text class="hero-k">FIELD STATE</text><text class="hero-v red">{{fieldState}}</text><text class="hero-sub danger-sub">{{fusionReason}}</text></div>
    </div>

    <list class="feature-list tactical-list">
      <list-item class="feature-row"><input type="button" class="feature-btn tactical-feature" value="TACTICAL LIGHT" onclick="f19"/><text class="source red">WATCH</text></list-item>
      <list-item class="feature-row"><input type="button" class="feature-btn tactical-feature" value="GRID-DOWN" onclick="f20"/><text class="source red">WATCH</text></list-item>
      <list-item class="feature-row"><input type="button" class="feature-btn tactical-feature danger-feature" value="EMERGENCY CORE" onclick="f21"/><text class="source red">WATCH+PHONE</text></list-item>
      <list-item class="feature-row"><input type="button" class="feature-btn gated-feature" value="DEPTH HUD" onclick="f22"/><text class="source warning-text">API GATED</text></list-item>
    </list>
    <div class="category-dock tactical-dock"><input type="button" class="dock-item" value="BIO" onclick="catBio"/><input type="button" class="dock-item" value="RUN" onclick="catSport"/><input type="button" class="dock-item" value="NAV" onclick="catNav"/><input type="button" class="dock-item" value="ENV" onclick="catEnv"/><input type="button" class="dock-item active danger-active" value="TAC" onclick="catTactical"/><input type="button" class="dock-item" value="SYS" onclick="catSystem"/></div>
  </div>

  <div if="{{showSystem}}" class="page masterpiece-page system-page-v4 page-enter">
    <div class="system-status-strip"><div class="status-cell"><text class="status-dot online">●</text><text class="status-label">CORE</text></div><div class="status-cell"><text class="status-dot online">●</text><text class="status-label">SYSTEM</text></div><text class="status-label">CACHE {{cacheState}}</text><text class="battery-mini">{{watchBattery}}%</text></div>
    <div class="header"><input type="button" class="back-cyber" value="‹" onclick="goHome"/><div class="status-area"><text class="status-title">LINK</text><text class="status-secure">{{connectionState}}</text></div></div>
    <div class="page-header compact-header"><text class="page-title">SYSTEM</text><div class="subtitle-row"><div class="subtitle-line pulse-line"></div><text class="page-subtitle">DEVICE CONTROL</text><div class="subtitle-line pulse-line"></div></div></div>

    <div class="system-core-panel">
      <div class="system-core-ring"><div class="system-core-inner"><text class="system-core-value">{{watchBattery}}%</text><text class="system-core-label">BATTERY</text></div></div>
      <div class="system-side">
        <div class="sys-row"><text class="sys-k">PHONE</text><text class="sys-v">{{connectionState}}</text></div>
        <div class="sys-row"><text class="sys-k">POWER</text><text class="sys-v">{{powerLabel}}</text></div>
        <div class="sys-row"><text class="sys-k">MOTION</text><text class="sys-v">{{motionArmed}}</text></div>
        <div class="link-visual system-link"><div class="link-node">WATCH</div><div class="link-line"><div if="{{powerProfile != 'ENDURANCE'}}" class="link-packet"></div></div><div class="link-node">PHONE</div></div>
      </div>
    </div>

    <list class="feature-list system-list">
      <list-item class="feature-row"><input type="button" class="feature-btn gated-feature" value="LIGHT GUARDIAN" onclick="f23"/><text class="source warning-text">API GATED</text></list-item>
      <list-item class="feature-row"><input type="button" class="feature-btn" value="POWER COMMANDER" onclick="f24"/><text class="source">WATCH</text></list-item>
      <list-item class="feature-row"><input type="button" class="feature-btn" value="MOTION COMMAND" onclick="f25"/><text class="source">WATCH</text></list-item>
      <list-item class="feature-row"><input type="button" class="feature-btn" value="VOICE COMMAND" onclick="f26"/><text class="source">PHONE</text></list-item>
      <list-item class="feature-row"><input type="button" class="feature-btn" value="DEVICE ACCESS" onclick="f27"/><text class="source">WATCH+PHONE</text></list-item>
    </list>
    <div class="category-dock"><input type="button" class="dock-item" value="BIO" onclick="catBio"/><input type="button" class="dock-item" value="RUN" onclick="catSport"/><input type="button" class="dock-item" value="NAV" onclick="catNav"/><input type="button" class="dock-item" value="ENV" onclick="catEnv"/><input type="button" class="dock-item" value="TAC" onclick="catTactical"/><input type="button" class="dock-item active" value="SYS" onclick="catSystem"/></div>
  </div>

  <div if="{{view == 'detail'}}" class="page masterpiece-page detail-page detail-page-v4 page-enter">
    <div class="system-status-strip"><div class="status-cell"><text class="status-dot online">●</text><text class="status-label">CORE</text></div><text class="status-label">ID {{selectedId}}</text><text class="status-label">{{selectedSource}}</text><text class="battery-mini">{{watchBattery}}%</text></div>
    <div class="header"><input type="button" class="back-cyber" value="‹" onclick="goList"/><div class="status-area"><text class="status-title">STATE</text><text class="status-secure">{{featureState}}</text></div></div>
    <div class="page-header detail-header"><text class="page-title detail-title">{{selectedTitle}}</text><div class="subtitle-row"><div class="subtitle-line pulse-line"></div><text class="page-subtitle">{{selectedSource}}</text><div class="subtitle-line pulse-line"></div></div></div>

    <div if="{{selectedId == '0'}}" class="module-stage vertical-stage">
      <div class="command-core"><div if="{{powerProfile != 'ENDURANCE'}}" class="command-pulse"></div><text class="command-state">{{fieldState}}</text><text class="command-app">{{fusionReason}}</text></div>
      <div class="context-slots"><text class="slot-chip">BIO</text><text class="slot-chip">NAV</text><text class="slot-chip">ENV</text><text class="slot-chip">SYSTEM</text></div>
    </div>

    <div if="{{selectedId == '1'}}" class="module-stage vertical-stage">
      <div class="voice-core bio-voice"><div if="{{powerProfile != 'ENDURANCE'}}" class="voice-ring vr1"></div><div if="{{powerProfile != 'ENDURANCE'}}" class="voice-ring vr2"></div><text class="voice-icon">{{heartRate}}</text></div>
      <div class="eq-row detail-eq"><div class="eq-bar eq1"></div><div class="eq-bar eq2"></div><div class="eq-bar eq3"></div><div class="eq-bar eq4"></div><div class="eq-bar eq5"></div><div class="eq-bar eq6"></div><div class="eq-bar eq7"></div></div>
    </div>

    <div if="{{selectedId == '2'}}" class="module-stage vertical-stage">
      <div class="provider-panel"><text class="provider-title">HUAWEI HEALTH</text><text class="provider-state">SCOPE / USER AUTH REQUIRED</text></div>
      <text class="module-note">REAL DATA ONLY • NO SYNTHETIC READINESS</text>
    </div>

    <div if="{{selectedId == '3'}}" class="module-stage">
      <div class="motion-orbit"><div if="{{powerProfile != 'ENDURANCE'}}" class="motion-ring"></div><text class="motion-wrist">BIO</text></div>
      <div class="module-side"><div class="module-stat"><text class="module-k">HR</text><text class="module-v">{{heartRate}}</text></div><div class="module-stat"><text class="module-k">FIELD</text><text class="module-v">{{fieldState}}</text></div><div class="module-stat"><text class="module-k">IMPACT</text><text class="module-v">{{impactButtonLabel}}</text></div></div>
    </div>

    <div if="{{selectedId == '4'}}" class="module-stage vertical-stage">
      <div class="telemetry-row"><text class="telemetry-label">SPEED</text><div class="telemetry-track"><div class="telemetry-stream"></div></div><text class="telemetry-num">{{speedKmh}}</text></div>
      <div class="telemetry-row"><text class="telemetry-label">HR</text><div class="telemetry-track"><div class="telemetry-stream delay1"></div></div><text class="telemetry-num">{{heartRate}}</text></div>
      <div class="telemetry-row"><text class="telemetry-label">ALT</text><div class="telemetry-track"><div class="telemetry-stream delay2"></div></div><text class="telemetry-num">{{altitude}}</text></div>
    </div>

    <div if="{{selectedId == '5'}}" class="module-stage">
      <div class="mini-dial"><div class="mini-dial-core"><text class="mini-dial-value">{{speedKmh}}</text><text class="mini-dial-label">KM/H</text></div></div>
      <div class="module-side"><div class="module-stat"><text class="module-k">GPS</text><text class="module-v">{{gpsState}}</text></div><div class="module-stat"><text class="module-k">HR</text><text class="module-v">{{heartRate}}</text></div><div class="module-stat"><text class="module-k">POWER</text><text class="module-v">{{powerProfile}}</text></div></div>
    </div>

    <div if="{{selectedId == '6'}}" class="module-stage vertical-stage">
      <div class="aqua-core"><div class="aqua-ring aq1"></div><div class="aqua-ring aq2"></div><text class="aqua-text">{{featureState}}</text></div>
      <div class="mini-stat-row"><div class="mini-stat"><text class="mini-k">RETURN</text><text class="mini-v">{{returning}}</text></div><div class="mini-stat wide-stat"><text class="mini-k">ROUTE</text><text class="mini-v">{{routeSummary}}</text></div></div>
    </div>

    <div if="{{selectedId == '7'}}" class="module-stage">
      <div class="mini-dial golf-dial"><div class="mini-dial-core"><text class="mini-dial-value">{{featureData}}</text><text class="mini-dial-label">SCORE DATA</text></div></div>
      <div class="module-side"><div class="module-stat"><text class="module-k">SOURCE</text><text class="module-v">PHONE</text></div><div class="module-stat"><text class="module-k">STATE</text><text class="module-v">{{featureState}}</text></div></div>
    </div>

    <div if="{{selectedId == '8'}}" class="module-stage">
      <div class="network-radar detail-radar"><div class="radar-ring r1"></div><div class="radar-ring r2"></div><div class="radar-ring r3"></div><div if="{{powerProfile != 'ENDURANCE'}}" class="radar-sweep"></div><div class="radar-core"><text class="radar-value">{{heading}}</text><text class="radar-label">{{headingNameText}}</text></div></div>
      <div class="module-side"><div class="module-stat"><text class="module-k">GPS</text><text class="module-v">{{gpsState}}</text></div><div class="module-stat"><text class="module-k">ALT</text><text class="module-v">{{altitude}}</text></div><div class="module-stat"><text class="module-k">SPEED</text><text class="module-v">{{speedKmh}}</text></div></div>
    </div>

    <div if="{{selectedId == '9'}}" class="module-stage vertical-stage">
      <div class="haptic-lanes"><div class="haptic-line"><div class="haptic-pulse hp1"></div></div><div class="haptic-line"><div class="haptic-pulse hp2"></div></div><div class="haptic-line"><div class="haptic-pulse hp3"></div></div></div>
      <text class="module-note">PHONE NAVIGATION → WATCH HAPTIC INSTRUCTIONS</text>
    </div>

    <div if="{{selectedId == '10'}}" class="module-stage vertical-stage">
      <div class="breadcrumb-flow"><div class="trail-dot t1"></div><div class="trail-dot t2"></div><div class="trail-dot t3"></div><div class="trail-dot t4"></div><div if="{{powerProfile != 'ENDURANCE'}}" class="trail-packet"></div></div>
      <div class="mini-stat-row"><div class="mini-stat"><text class="mini-k">POINTS</text><text class="mini-v">{{breadcrumbPoints}}</text></div><div class="mini-stat wide-stat"><text class="mini-k">ROUTE</text><text class="mini-v">{{routeSummary}}</text></div></div>
    </div>

    <div if="{{selectedId == '11'}}" class="module-stage">
      <div class="anchor-radar"><div class="anchor-ring ar1"></div><div class="anchor-ring ar2"></div><div if="{{powerProfile != 'ENDURANCE'}}" class="anchor-sweep"></div><text class="anchor-center">{{anchorsCount}}</text></div>
      <div class="module-side"><div class="module-stat"><text class="module-k">SLOTS</text><text class="module-v">{{anchorsCount}} / 20</text></div><div class="module-stat"><text class="module-k">GPS</text><text class="module-v">{{gpsState}}</text></div><div class="module-stat"><text class="module-k">RETURN</text><text class="module-v">{{returning}}</text></div></div>
    </div>

    <div if="{{selectedId == '12'}}" class="module-stage vertical-stage">
      <div class="transit-track"><div class="transit-node">A</div><div class="transit-line"><div if="{{powerProfile != 'ENDURANCE'}}" class="transit-packet"></div></div><div class="transit-node">B</div></div>
      <text class="module-note">PROVIDER STATUS: {{featureState}}</text>
    </div>

    <div if="{{selectedId == '13'}}" class="module-stage">
      <div class="mini-dial"><div class="mini-dial-core"><text class="mini-dial-value">{{pressure}}</text><text class="mini-dial-label">hPa</text></div></div>
      <div class="module-side"><div class="module-stat"><text class="module-k">TREND</text><text class="module-v">{{pressureTrend}}</text></div><div class="module-stat"><text class="module-k">WEATHER</text><text class="module-v">{{weatherState}}</text></div><div class="module-stat"><text class="module-k">TEMP</text><text class="module-v">{{weatherTemp}}</text></div></div>
    </div>

    <div if="{{selectedId == '14'}}" class="module-stage vertical-stage">
      <div class="solar-orbit"><div class="sun-core">SUN</div><div class="sun-orbit so1"></div><div class="sun-orbit so2"></div><div class="sun-dot sd1"></div><div class="sun-dot sd2"></div></div>
      <div class="mini-stat-row"><div class="mini-stat"><text class="mini-k">UV</text><text class="mini-v">{{weatherUV}}</text></div><div class="mini-stat wide-stat"><text class="mini-k">SUNSET</text><text class="mini-v">{{weatherSun}}</text></div></div>
    </div>

    <div if="{{selectedId == '15'}}" class="module-stage vertical-stage">
      <div class="heat-bars"><div class="heat-bar hb1"></div><div class="heat-bar hb2"></div><div class="heat-bar hb3"></div><div class="heat-bar hb4"></div><div class="heat-bar hb5"></div></div>
      <div class="mini-stat-row"><div class="mini-stat"><text class="mini-k">TEMP</text><text class="mini-v">{{weatherTemp}}</text></div><div class="mini-stat wide-stat"><text class="mini-k">DATA</text><text class="mini-v">{{featureData}}</text></div></div>
    </div>

    <div if="{{selectedId == '16'}}" class="module-stage">
      <div class="altitude-graph"><div class="alt-step as1"></div><div class="alt-step as2"></div><div class="alt-step as3"></div><div class="alt-step as4"></div><div class="alt-step as5"></div></div>
      <div class="module-side"><div class="module-stat"><text class="module-k">ALTITUDE</text><text class="module-v">{{altitude}}</text></div><div class="module-stat"><text class="module-k">PRESSURE</text><text class="module-v">{{pressure}}</text></div><div class="module-stat"><text class="module-k">GPS</text><text class="module-v">{{gpsState}}</text></div></div>
    </div>

    <div if="{{selectedId == '17'}}" class="module-stage vertical-stage">
      <div class="sky-orbit"><div class="sky-core">SKY</div><div class="sky-ring sr1"></div><div class="sky-ring sr2"></div><div class="sky-dot sk1"></div><div class="sky-dot sk2"></div><div class="sky-dot sk3"></div></div>
      <div class="mini-stat-row"><div class="mini-stat"><text class="mini-k">SUNSET</text><text class="mini-v">{{weatherSun}}</text></div><div class="mini-stat wide-stat"><text class="mini-k">STATE</text><text class="mini-v">{{weatherState}}</text></div></div>
    </div>

    <div if="{{selectedId == '18'}}" class="module-stage vertical-stage">
      <div class="eq-row acoustic-eq"><div class="eq-bar eq1"></div><div class="eq-bar eq4"></div><div class="eq-bar eq2"></div><div class="eq-bar eq6"></div><div class="eq-bar eq3"></div><div class="eq-bar eq5"></div><div class="eq-bar eq7"></div></div>
      <div class="provider-panel compact-provider"><text class="provider-title">ACOUSTIC PROVIDER</text><text class="provider-state">{{featureState}}</text></div>
    </div>

    <div if="{{selectedId == '19'}}" class="module-stage">
      <div class="light-core"><div class="light-ray lr1"></div><div class="light-ray lr2"></div><div class="light-ray lr3"></div><div class="light-ray lr4"></div><text class="light-core-text">LIGHT</text></div>
      <div class="module-side"><div class="module-stat"><text class="module-k">MODE</text><text class="module-v">SCREEN LIGHT</text></div><div class="module-stat"><text class="module-k">POWER</text><text class="module-v">{{powerProfile}}</text></div></div>
    </div>

    <div if="{{selectedId == '20'}}" class="module-stage">
      <div class="shield-core"><div if="{{powerProfile != 'ENDURANCE'}}" class="shield-ring"></div><text class="shield-text">GRID</text></div>
      <div class="module-side"><div class="module-stat"><text class="module-k">CACHE</text><text class="module-v">{{cacheState}}</text></div><div class="module-stat"><text class="module-k">ROUTE</text><text class="module-v">{{routeSummary}}</text></div><div class="module-stat"><text class="module-k">POWER</text><text class="module-v">{{powerProfile}}</text></div></div>
    </div>

    <div if="{{selectedId == '21'}}" class="module-stage emergency-stage">
      <div class="emergency-mini"><div if="{{powerProfile != 'ENDURANCE'}}" class="emergency-mini-pulse"></div><text class="emergency-mini-text">SOS</text></div>
      <div class="module-side"><div class="module-stat"><text class="module-k">GPS</text><text class="module-v">{{gpsState}}</text></div><div class="module-stat"><text class="module-k">IMPACT</text><text class="module-v">{{impactButtonLabel}}</text></div><div class="module-stat"><text class="module-k">RETURN</text><text class="module-v">{{returning}}</text></div></div>
    </div>

    <div if="{{selectedId == '22'}}" class="module-stage vertical-stage">
      <div class="gated-core"><div class="gated-ring"></div><text class="gated-text">API GATED</text></div><text class="module-note warning-text">DEPTH HARDWARE ACCESS NOT ASSUMED</text>
    </div>

    <div if="{{selectedId == '23'}}" class="module-stage vertical-stage">
      <div class="gated-core"><div class="gated-ring"></div><text class="gated-text">API GATED</text></div><text class="module-note warning-text">AMBIENT LIGHT RAW ACCESS NOT ASSUMED</text>
    </div>

    <div if="{{selectedId == '24'}}" class="module-stage">
      <div class="mini-dial system-dial"><div class="mini-dial-core"><text class="mini-dial-value">{{watchBattery}}%</text><text class="mini-dial-label">BATTERY</text></div></div>
      <div class="module-side"><div class="module-stat"><text class="module-k">PROFILE</text><text class="module-v">{{powerProfile}}</text></div><div class="module-stat"><text class="module-k">AUTO</text><text class="module-v">{{powerAuto}}</text></div><div class="module-stat"><text class="module-k">LABEL</text><text class="module-v small-module">{{powerLabel}}</text></div></div>
    </div>

    <div if="{{selectedId == '25'}}" class="module-stage vertical-stage">
      <div class="motion-orbit"><div if="{{powerProfile != 'ENDURANCE'}}" class="motion-ring"></div><text class="motion-wrist">⌁</text></div>
      <div class="gesture-grid"><text class="gesture-chip">ARM</text><text class="gesture-chip">CALIBRATE</text><text class="gesture-chip">DISARM</text><text class="gesture-chip">{{motionArmed}}</text></div>
    </div>

    <div if="{{selectedId == '26'}}" class="module-stage vertical-stage">
      <div class="voice-core"><div if="{{powerProfile != 'ENDURANCE'}}" class="voice-ring vr1"></div><div if="{{powerProfile != 'ENDURANCE'}}" class="voice-ring vr2"></div><text class="voice-icon">MIC</text></div>
      <div class="eq-row detail-eq"><div class="eq-bar eq1"></div><div class="eq-bar eq3"></div><div class="eq-bar eq6"></div><div class="eq-bar eq4"></div><div class="eq-bar eq2"></div><div class="eq-bar eq5"></div><div class="eq-bar eq7"></div></div>
    </div>

    <div if="{{selectedId == '27'}}" class="module-stage vertical-stage">
      <div class="shield-core device-shield"><div if="{{powerProfile != 'ENDURANCE'}}" class="shield-ring"></div><text class="shield-text">ACCESS</text></div>
      <div class="trust-grid"><div class="trust-cell"><text class="trust-k">PHONE</text><text class="trust-v">{{connectionState}}</text></div><div class="trust-cell"><text class="trust-k">GPS</text><text class="trust-v">{{gpsState}}</text></div><div class="trust-cell"><text class="trust-k">CACHE</text><text class="trust-v">{{cacheState}}</text></div><div class="trust-cell"><text class="trust-k">POWER</text><text class="trust-v">{{powerProfile}}</text></div></div>
    </div>

    <div class="detail-card">
      <text class="detail-desc">{{selectedDesc}}</text>
      <div class="metric-row"><text class="label">DATA</text><text class="value small-value">{{featureData}}</text></div>
      <div class="metric-row"><text class="label">MESSAGE</text><text class="value small-value">{{message}}</text></div>
    </div>

    <div class="detail-actions">
      <input if="{{action1Label != ''}}" type="button" class="hud-action active-state" value="{{action1Label}}" onclick="detailAction1"/>
      <input if="{{action2Label != ''}}" type="button" class="hud-action" value="{{action2Label}}" onclick="detailAction2"/>
      <input if="{{action3Label != ''}}" type="button" class="hud-action" value="{{action3Label}}" onclick="detailAction3"/>
      <input if="{{action4Label != ''}}" type="button" class="hud-action danger" value="{{action4Label}}" onclick="detailAction4"/>
    </div>
    <div if="{{selectedId == '10'}}" class="detail-extra"><input type="button" class="mini-extra" value="NEW ROUTE" onclick="newBreadcrumb"/><input type="button" class="mini-extra" value="STOP RETURN" onclick="stopReturn"/></div>
    <div if="{{selectedId == '21'}}" class="detail-extra"><input type="button" class="mini-extra" value="{{impactButtonLabel}}" onclick="toggleImpactAssist"/><input type="button" class="mini-extra danger" value="COUNTDOWN" onclick="startEmergencyCountdown"/></div>
    <input if="{{selectedId == '24'}}" type="button" class="wide-extra" value="AUTO POWER" onclick="enableAutoPower"/>
    <input if="{{selectedId == '27'}}" type="button" class="wide-extra" value="CAPABILITY MATRIX" onclick="openCapabilities"/>
    <input if="{{selectedId == '0'}}" type="button" class="wide-extra advanced-wide" value="COMMAND CENTER" onclick="openCommandCenter"/>
    <input if="{{selectedId == '27'}}" type="button" class="wide-extra advanced-wide" value="RECON / WI-FI SCOUT" onclick="openReconHub"/>
  </div>

  <div if="{{view == 'anchors'}}" class="page masterpiece-page utility-page page-enter">
    <div class="system-status-strip"><div class="status-cell"><text class="status-dot online">●</text><text class="status-label">CORE</text></div><div class="status-cell"><text class="status-dot online">●</text><text class="status-label">GPS</text></div><text class="status-label">LOCAL DB</text><text class="battery-mini">{{anchorsCount}} / 20</text></div>
    <div class="header"><input type="button" class="back-cyber" value="‹" onclick="goHome"/><div class="status-area"><text class="status-title">SLOTS</text><text class="status-secure">{{anchorsCount}} / 20</text></div></div>
    <div class="page-header compact-header"><text class="page-title">GEO ANCHORS</text><div class="subtitle-row"><div class="subtitle-line pulse-line"></div><text class="page-subtitle">NAV DATABASE</text><div class="subtitle-line pulse-line"></div></div></div>
    <div class="anchor-grid">
      <div class="anchor-row"><div class="anchor-card"><text class="anchor-name">{{anchor1}}</text><text class="anchor-meta">{{anchor1Meta}}</text><input type="button" class="anchor-go" value="RETURN" onclick="anchor1Return"/></div><div class="anchor-card"><text class="anchor-name">{{anchor2}}</text><text class="anchor-meta">{{anchor2Meta}}</text><input type="button" class="anchor-go" value="RETURN" onclick="anchor2Return"/></div></div>
      <div class="anchor-row"><div class="anchor-card"><text class="anchor-name">{{anchor3}}</text><text class="anchor-meta">{{anchor3Meta}}</text><input type="button" class="anchor-go" value="RETURN" onclick="anchor3Return"/></div><div class="anchor-card"><text class="anchor-name">{{anchor4}}</text><text class="anchor-meta">{{anchor4Meta}}</text><input type="button" class="anchor-go" value="RETURN" onclick="anchor4Return"/></div></div>
    </div>
    <div class="detail-extra"><input type="button" class="mini-extra" value="PREV" onclick="anchorPrev"/><input type="button" class="mini-extra" value="NEXT" onclick="anchorNext"/></div>
    <div class="detail-extra"><input type="button" class="mini-extra" value="SAVE NEW" onclick="detailAction1"/><input type="button" class="mini-extra danger" value="DELETE LAST" onclick="deleteLastAnchor"/></div>
  </div>

  <div if="{{view == 'timeline'}}" class="page masterpiece-page utility-page page-enter">
    <div class="system-status-strip"><div class="status-cell"><text class="status-dot online">●</text><text class="status-label">CORE</text></div><div class="status-cell"><text class="status-dot online">●</text><text class="status-label">LOG</text></div><text class="status-label">LOCAL</text><text class="battery-mini">80 MAX</text></div>
    <div class="header"><input type="button" class="back-cyber" value="‹" onclick="goHome"/><div class="status-area"><text class="status-title">STORE</text><text class="status-secure">LOCAL</text></div></div>
    <div class="page-header compact-header"><text class="page-title">MISSION TIMELINE</text><div class="subtitle-row"><div class="subtitle-line pulse-line"></div><text class="page-subtitle">LOCAL EVENT LOG</text><div class="subtitle-line pulse-line"></div></div></div>
    <div class="timeline-flow"><div class="timeline-rail"><div class="timeline-pulse"></div></div><div class="timeline-stack"><div class="timeline-card"><text class="timeline-line">{{timeline1}}</text></div><div class="timeline-card"><text class="timeline-line">{{timeline2}}</text></div><div class="timeline-card"><text class="timeline-line">{{timeline3}}</text></div><div class="timeline-card"><text class="timeline-line">{{timeline4}}</text></div></div></div>
    <div class="detail-extra"><input type="button" class="mini-extra" value="NEWER" onclick="timelineNewer"/><input type="button" class="mini-extra" value="OLDER" onclick="timelineOlder"/></div>
    <input type="button" class="wide-extra danger" value="CLEAR TIMELINE" onclick="clearTimeline"/>
  </div>

  <div if="{{view == 'capabilities'}}" class="page masterpiece-page utility-page page-enter">
    <div class="system-status-strip"><div class="status-cell"><text class="status-dot online">●</text><text class="status-label">CORE</text></div><div class="status-cell"><text class="status-dot online">●</text><text class="status-label">ACCESS</text></div><text class="status-label">REAL DATA ONLY</text><text class="battery-mini">{{watchBattery}}%</text></div>
    <div class="header"><input type="button" class="back-cyber" value="‹" onclick="goHome"/><div class="status-area"><text class="status-title">POLICY</text><text class="status-secure">REAL ONLY</text></div></div>
    <div class="page-header compact-header"><text class="page-title">DEVICE ACCESS</text><div class="subtitle-row"><div class="subtitle-line pulse-line"></div><text class="page-subtitle">CAPABILITY MATRIX</text><div class="subtitle-line pulse-line"></div></div></div>
    <div class="cap-stage"><div class="shield-core device-shield"><div if="{{powerProfile != 'ENDURANCE'}}" class="shield-ring"></div><text class="shield-text">ACCESS</text></div><div class="cap-panel"><text class="cap-text">{{capabilityText}}</text></div></div>
    <input type="button" class="wide-extra" value="REFRESH PHONE STATUS" onclick="detailAction1"/>
    <input type="button" class="wide-extra" value="SYNC" onclick="detailAction2"/>
    <text class="gated-note">DEPTH + AMBIENT LIGHT • API GATED</text>
  </div>


  <div if="{{view == 'advancedHub'}}" class="page masterpiece-page utility-page advanced-hub-v4 page-enter">
    <div class="system-status-strip"><div class="status-cell"><text class="status-dot online">●</text><text class="status-label">CORE</text></div><div class="status-cell"><text class="status-dot online">●</text><text class="status-label">ADVANCED</text></div><text class="status-label">{{quickProfile}}</text><text class="battery-mini">{{watchBattery}}%</text></div>
    <div class="header"><input type="button" class="back-cyber" value="‹" onclick="goHome"/><div class="status-area"><text class="status-title">CONTEXT</text><text class="status-secure">{{contextMode}}</text></div></div>
    <div class="page-header compact-header"><text class="page-title">FIELD CORE PRO</text><div class="subtitle-row"><div class="subtitle-line pulse-line"></div><text class="page-subtitle">CONTEXT • MISSION • RECON</text><div class="subtitle-line pulse-line"></div></div></div>
    <div class="advanced-summary"><div class="adv-stat"><text class="adv-k">WIFI</text><text class="adv-v">{{wifiCount}}</text></div><div class="adv-stat"><text class="adv-k">BT</text><text class="adv-v">{{btCount}}</text></div><div class="adv-stat"><text class="adv-k">MISSION</text><text class="adv-v">{{missionLabel}}</text></div><div class="adv-stat"><text class="adv-k">RISK</text><text class="adv-v">{{envRisk}}</text></div></div>
    <list class="advanced-list">
      <list-item class="advanced-row"><input type="button" class="advanced-btn active-state" value="COMMAND CENTER" onclick="openCommandCenter"/><text class="advanced-source">CORE</text></list-item>
      <list-item class="advanced-row"><input type="button" class="advanced-btn" value="FIELD CONTEXT ENGINE 2.0" onclick="advContext"/><text class="advanced-source">FUSION</text></list-item>
      <list-item class="advanced-row"><input type="button" class="advanced-btn" value="TELEMETRY CONFIDENCE" onclick="advTelemetry"/><text class="advanced-source">QUALITY</text></list-item>
      <list-item class="advanced-row"><input type="button" class="advanced-btn" value="LOST MODE PRO" onclick="advLostMode"/><text class="advanced-source">NAV</text></list-item>
      <list-item class="advanced-row"><input type="button" class="advanced-btn" value="MISSION PACK OFFLINE" onclick="advMissionPack"/><text class="advanced-source">OFFLINE</text></list-item>
      <list-item class="advanced-row"><input type="button" class="advanced-btn" value="SMART GEO ANCHOR" onclick="advSmartAnchor"/><text class="advanced-source">WATCH</text></list-item>
      <list-item class="advanced-row"><input type="button" class="advanced-btn" value="ENVIRONMENT RISK INDEX" onclick="advEnvRisk"/><text class="advanced-source">ENV</text></list-item>
      <list-item class="advanced-row"><input type="button" class="advanced-btn" value="POWER COMMANDER AUTO 2.0" onclick="advPowerAuto"/><text class="advanced-source">WATCH</text></list-item>
      <list-item class="advanced-row"><input type="button" class="advanced-btn" value="SENSOR SELF-TEST" onclick="advSensorTest"/><text class="advanced-source">SYSTEM</text></list-item>
      <list-item class="advanced-row"><input type="button" class="advanced-btn" value="MISSION TIMELINE PRO" onclick="advTimeline"/><text class="advanced-source">EVENTS</text></list-item>
      <list-item class="advanced-row"><input type="button" class="advanced-btn" value="VOICE MACRO ENGINE" onclick="advVoiceMacro"/><text class="advanced-source">PHONE</text></list-item>
      <list-item class="advanced-row"><input type="button" class="advanced-btn" value="FIELD NOTIFICATION FILTER" onclick="advNotification"/><text class="advanced-source">ALERT</text></list-item>
      <list-item class="advanced-row"><input type="button" class="advanced-btn" value="NEARBY DEVICE RECON" onclick="advBtRecon"/><text class="advanced-source">PHONE BLE</text></list-item>
      <list-item class="advanced-row"><input type="button" class="advanced-btn" value="RUNNING ZONE HUD" onclick="advRunZone"/><text class="advanced-source">SPORT</text></list-item>
      <list-item class="advanced-row"><input type="button" class="advanced-btn" value="SKY SCANNER PRO" onclick="advSkyPro"/><text class="advanced-source">PHONE</text></list-item>
      <list-item class="advanced-row"><input type="button" class="advanced-btn" value="NIGHT / STEALTH HUD" onclick="advStealth"/><text class="advanced-source">POWER</text></list-item>
      <list-item class="advanced-row"><input type="button" class="advanced-btn" value="RETURN DECISION HUD" onclick="advReturnDecision"/><text class="advanced-source">NAV</text></list-item>
      <list-item class="advanced-row"><input type="button" class="advanced-btn" value="FIELD QUICK PROFILES" onclick="advProfiles"/><text class="advanced-source">SYSTEM</text></list-item>
      <list-item class="advanced-row"><input type="button" class="advanced-btn" value="IMPACT REVIEW SCREEN" onclick="advImpactReview"/><text class="advanced-source">SAFETY</text></list-item>
      <list-item class="advanced-row"><input type="button" class="advanced-btn danger-feature" value="EMERGENCY ESCALATION" onclick="advEmergencyEscalation"/><text class="advanced-source danger-text">P1–P4</text></list-item>
      <list-item class="advanced-row"><input type="button" class="advanced-btn" value="WI-FI SCOUT / CYBER SWEEP" onclick="openWifiScout"/><text class="advanced-source">RECON</text></list-item>
      <list-item class="advanced-row"><input type="button" class="advanced-btn" value="FIELD CORE SETTINGS" onclick="advSettings"/><text class="advanced-source">PRIVACY</text></list-item>
    </list>
  </div>

  <div if="{{view == 'wifiScout'}}" class="page masterpiece-page utility-page wifi-scout-v4 page-enter">
    <div class="system-status-strip"><div class="status-cell"><text class="status-dot online">●</text><text class="status-label">CORE</text></div><div class="status-cell"><text class="status-dot online">●</text><text class="status-label">PHONE SCAN</text></div><text class="status-label">AGE {{wifiAge}}s</text><text class="battery-mini">{{watchBattery}}%</text></div>
    <div class="header"><input type="button" class="back-cyber" value="‹" onclick="advancedBack"/><div class="status-area"><text class="status-title">PHONE LINK</text><text class="status-secure">{{connectionState}}</text></div></div>
    <div class="page-header compact-header"><text class="page-title">WI-FI SCOUT</text><div class="subtitle-row"><div class="subtitle-line pulse-line"></div><text class="page-subtitle">RADAR • LOCAL HISTORY</text><div class="subtitle-line pulse-line"></div></div></div>
    <div class="wifi-stage"><div class="network-radar wifi-radar"><div class="radar-ring r1"></div><div class="radar-ring r2"></div><div class="radar-ring r3"></div><div if="{{powerProfile != 'ENDURANCE'}}" class="radar-sweep"></div><div class="radar-core"><text class="radar-value">{{wifiCount}}</text><text class="radar-label">NETWORKS</text></div></div><div class="wifi-side"><div class="module-stat"><text class="module-k">OPEN</text><text class="module-v warning-text">{{wifiOpen}}</text></div><div class="module-stat"><text class="module-k">SECURED</text><text class="module-v">{{wifiSecured}}</text></div><div class="module-stat"><text class="module-k">BEST</text><text class="module-v wifi-best">{{wifiBest}}</text></div></div></div>
    <div class="wifi-menu">
      <div class="wifi-row"><input type="button" class="wifi-btn active-state" value="SCAN" onclick="advWifiScan"/><input type="button" class="wifi-btn" value="NETWORKS" onclick="advWifiNetworks"/><input type="button" class="wifi-btn warning-btn" value="OPEN" onclick="advWifiOpen"/></div>
      <div class="wifi-row"><input type="button" class="wifi-btn" value="BEST" onclick="advWifiBest"/><input type="button" class="wifi-btn" value="CHANNELS" onclick="advWifiChannels"/><input type="button" class="wifi-btn" value="HISTORY" onclick="advWifiHistory"/></div>
      <div class="wifi-row"><input type="button" class="wifi-btn" value="TRUSTED" onclick="advWifiTrusted"/><input type="button" class="wifi-btn" value="OUTDOOR" onclick="advWifiOutdoor"/><input type="button" class="wifi-btn" value="CYBER SWEEP" onclick="advCyberSweep"/></div>
      <div class="wifi-row"><input type="button" class="wifi-btn" value="BT RECON" onclick="advBtScan"/><input type="button" class="wifi-btn" value="SIGNAL HUNT" onclick="advWifiSignal"/><input type="button" class="wifi-btn" value="DUPLICATE" onclick="advWifiDuplicates"/></div>
    </div>
    <text class="wifi-note">RSSI = SIGNAL PROXIMITY • NOT PHYSICAL DISTANCE</text>
  </div>


  <div if="{{view == 'wifiList'}}" class="page masterpiece-page utility-page wifi-list-v4 page-enter">
    <div class="system-status-strip"><div class="status-cell"><text class="status-dot online">●</text><text class="status-label">CORE</text></div><text class="status-label">LOCAL / PHONE</text><text class="status-label">AGE {{wifiAge}}s</text><text class="battery-mini">{{watchBattery}}%</text></div>
    <div class="header"><input type="button" class="back-cyber" value="‹" onclick="wifiListBack"/><div class="status-area"><text class="status-title">SORT</text><text class="status-secure">SIGNAL</text></div></div>
    <div class="page-header compact-header"><text class="page-title advanced-title">{{wifiListTitle}}</text><div class="subtitle-row"><div class="subtitle-line pulse-line"></div><text class="page-subtitle">RSSI • SECURITY • BAND</text><div class="subtitle-line pulse-line"></div></div></div>
    <div class="wifi-network-list">
      <div class="wifi-network-row"><input type="button" class="wifi-network-btn" value="{{wifi1}}" onclick="wifi1Detail"/><text class="wifi-network-meta">{{wifi1Meta}}</text></div>
      <div class="wifi-network-row"><input type="button" class="wifi-network-btn" value="{{wifi2}}" onclick="wifi2Detail"/><text class="wifi-network-meta">{{wifi2Meta}}</text></div>
      <div class="wifi-network-row"><input type="button" class="wifi-network-btn" value="{{wifi3}}" onclick="wifi3Detail"/><text class="wifi-network-meta">{{wifi3Meta}}</text></div>
      <div class="wifi-network-row"><input type="button" class="wifi-network-btn" value="{{wifi4}}" onclick="wifi4Detail"/><text class="wifi-network-meta">{{wifi4Meta}}</text></div>
    </div>
    <text class="wifi-note">OPEN ≠ FREE INTERNET • HIDDEN ≠ THREAT</text>
  </div>

  <div if="{{view == 'wifiDetail'}}" class="page masterpiece-page utility-page wifi-detail-v4 page-enter">
    <div class="system-status-strip"><div class="status-cell"><text class="status-dot online">●</text><text class="status-label">WI-FI</text></div><text class="status-label">DETAIL</text><text class="status-label">LOCAL</text><text class="battery-mini">{{watchBattery}}%</text></div>
    <div class="header"><input type="button" class="back-cyber" value="‹" onclick="advWifiNetworks"/><div class="status-area"><text class="status-title">RISK</text><text class="status-secure">{{wifiSelectedRisk}}</text></div></div>
    <div class="page-header compact-header"><text class="page-title advanced-title">{{wifiSelectedSsid}}</text><div class="subtitle-row"><div class="subtitle-line pulse-line"></div><text class="page-subtitle">NETWORK DETAIL</text><div class="subtitle-line pulse-line"></div></div></div>
    <div class="wifi-detail-card"><div class="wifi-detail-row"><text class="module-k">SIGNAL</text><text class="module-v">{{wifiSelectedRssi}} dBm</text></div><div class="wifi-detail-row"><text class="module-k">SECURITY</text><text class="module-v">{{wifiSelectedSecurity}}</text></div><div class="wifi-detail-row"><text class="module-k">BAND / CH</text><text class="module-v">{{wifiSelectedBand}} / {{wifiSelectedChannel}}</text></div><div class="wifi-detail-row"><text class="module-k">BSSID</text><text class="wifi-bssid">{{wifiSelectedBssid}}</text></div></div>
    <div class="wifi-detail-actions"><input type="button" class="wifi-detail-btn" value="TRUST" onclick="wifiTrustSelected"/><input type="button" class="wifi-detail-btn" value="PIN" onclick="wifiPinSelected"/><input type="button" class="wifi-detail-btn active-state" value="SIGNAL HUNT" onclick="wifiSignalSelected"/><input type="button" class="wifi-detail-btn warning-btn" value="HIDE" onclick="wifiHideSelected"/></div>
    <text class="wifi-note">SIGNAL HUNT USES RSSI TREND • NOT PHYSICAL DIRECTION</text>
  </div>

  <div if="{{view == 'cyberSweep'}}" class="page masterpiece-page utility-page cyber-sweep-v4 page-enter">
    <div class="system-status-strip"><div class="status-cell"><text class="status-dot online">●</text><text class="status-label">CORE</text></div><text class="status-label">CYBER SWEEP</text><text class="status-label">LOCAL</text><text class="battery-mini">{{watchBattery}}%</text></div>
    <div class="header"><input type="button" class="back-cyber" value="‹" onclick="openWifiScout"/><div class="status-area"><text class="status-title">STATE</text><text class="status-secure">{{advancedState}}</text></div></div>
    <div class="page-header compact-header"><text class="page-title">CYBER SWEEP</text><div class="subtitle-row"><div class="subtitle-line pulse-line"></div><text class="page-subtitle">WI-FI + BLUETOOTH</text><div class="subtitle-line pulse-line"></div></div></div>
    <div class="cyber-sweep-stage"><div class="network-radar sweep-radar"><div class="radar-ring r1"></div><div class="radar-ring r2"></div><div class="radar-ring r3"></div><div if="{{powerProfile != 'ENDURANCE'}}" class="radar-sweep"></div><div class="radar-core"><text class="radar-value">{{wifiCount}}</text><text class="radar-label">WIFI</text></div></div><div class="sweep-side"><div class="module-stat"><text class="module-k">BLUETOOTH</text><text class="module-v">{{btCount}}</text></div><div class="module-stat"><text class="module-k">TRUSTED</text><text class="module-v">{{btTrusted}}</text></div><div class="module-stat"><text class="module-k">UNKNOWN</text><text class="module-v">{{btUnknown}}</text></div><div class="module-stat"><text class="module-k">OPEN WIFI</text><text class="module-v warning-text">{{wifiOpen}}</text></div></div></div>
    <div class="detail-extra"><input type="button" class="mini-extra active-state" value="SCAN AGAIN" onclick="advCyberSweep"/><input type="button" class="mini-extra" value="DEVICE HISTORY" onclick="advBtHistory"/></div>
    <text class="wifi-note">NEW / UNKNOWN ≠ MALICIOUS</text>
  </div>

  <div if="{{view == 'advanced'}}" class="page masterpiece-page utility-page advanced-page-v4 page-enter">
    <div class="system-status-strip"><div class="status-cell"><text class="status-dot online">●</text><text class="status-label">CORE</text></div><div class="status-cell"><text class="status-dot online">●</text><text class="status-label">ADV</text></div><text class="status-label">{{advancedState}}</text><text class="battery-mini">{{watchBattery}}%</text></div>
    <div class="header"><input type="button" class="back-cyber" value="‹" onclick="advancedBack"/><div class="status-area"><text class="status-title">STATE</text><text class="status-secure">{{advancedState}}</text></div></div>
    <div class="page-header compact-header"><text class="page-title advanced-title">{{advancedTitle}}</text><div class="subtitle-row"><div class="subtitle-line pulse-line"></div><text class="page-subtitle">{{advancedSubtitle}}</text><div class="subtitle-line pulse-line"></div></div></div>
    <div class="advanced-core"><div class="command-core"><div if="{{powerProfile != 'ENDURANCE'}}" class="command-pulse"></div><text class="command-state">{{advancedState}}</text><text class="command-app">{{contextMode}}</text></div><div class="advanced-side"><div class="module-stat"><text class="module-k">CONTEXT</text><text class="module-v">{{contextMode}}</text></div><div class="module-stat"><text class="module-k">CONF</text><text class="module-v">{{contextConfidence}}</text></div><div class="module-stat"><text class="module-k">WIFI / BT</text><text class="module-v">{{wifiCount}} / {{btCount}}</text></div><div class="module-stat"><text class="module-k">RISK</text><text class="module-v">{{envRisk}}</text></div></div></div>

    <!-- VISUAL V4: every Advanced function gets its own graphic composition -->
    <div if="{{advancedTitle == 'COMMAND CENTER'}}" class="v4-stage v4-command-stage">
      <div class="v4-terrain"><div class="v4-terrain-line tl1"></div><div class="v4-terrain-line tl2"></div><div class="v4-terrain-line tl3"></div><div class="v4-command-target"><text class="v4-target-text">CORE</text></div></div>
      <div class="v4-side-stats"><div class="v4-stat"><text class="v4-k">MISSION</text><text class="v4-v">{{missionLabel}}</text></div><div class="v4-stat"><text class="v4-k">RISK</text><text class="v4-v">{{envRisk}}</text></div><div class="v4-stat"><text class="v4-k">WIFI / BT</text><text class="v4-v">{{wifiCount}} / {{btCount}}</text></div></div>
    </div>

    <div if="{{advancedTitle == 'FIELD CONTEXT'}}" class="v4-stage v4-context-stage">
      <div class="v4-context-wheel"><div class="v4-context-ring cr1"></div><div class="v4-context-ring cr2"></div><text class="v4-context-main">{{contextMode}}</text><text class="v4-context-conf">{{contextConfidence}}</text></div>
      <div class="v4-chip-grid"><text class="v4-chip">BIO</text><text class="v4-chip">NAV</text><text class="v4-chip">ENV</text><text class="v4-chip">POWER</text></div>
    </div>

    <div if="{{advancedTitle == 'TELEMETRY CONFIDENCE'}}" class="v4-stage v4-confidence-stage">
      <div class="v4-quality-row"><text class="v4-quality-label">GPS</text><div class="v4-quality-track"><div class="v4-quality-fill qf1"></div></div><text class="v4-quality-value">{{gpsState}}</text></div>
      <div class="v4-quality-row"><text class="v4-quality-label">HR</text><div class="v4-quality-track"><div class="v4-quality-fill qf2"></div></div><text class="v4-quality-value">{{heartRate}}</text></div>
      <div class="v4-quality-row"><text class="v4-quality-label">LINK</text><div class="v4-quality-track"><div class="v4-quality-fill qf3"></div></div><text class="v4-quality-value">{{connectionState}}</text></div>
      <div class="v4-quality-row"><text class="v4-quality-label">WIFI</text><div class="v4-quality-track"><div class="v4-quality-fill qf4"></div></div><text class="v4-quality-value">{{wifiAge}}s</text></div>
    </div>

    <div if="{{advancedTitle == 'LOST MODE PRO'}}" class="v4-stage v4-lost-stage">
      <div class="network-radar v4-lost-radar"><div class="radar-ring r1"></div><div class="radar-ring r2"></div><div class="radar-ring r3"></div><div if="{{powerProfile != 'ENDURANCE'}}" class="radar-sweep"></div><div class="radar-core"><text class="radar-value">{{breadcrumbPoints}}</text><text class="radar-label">RETURN</text></div></div>
      <div class="v4-side-stats"><div class="v4-stat"><text class="v4-k">GPS</text><text class="v4-v">{{gpsState}}</text></div><div class="v4-stat"><text class="v4-k">ROUTE</text><text class="v4-v">{{routeSummary}}</text></div><div class="v4-stat"><text class="v4-k">BATTERY</text><text class="v4-v">{{watchBattery}}%</text></div></div>
    </div>

    <div if="{{advancedTitle == 'MISSION PACK'}}" class="v4-stage v4-mission-stage">
      <div class="v4-mission-flow"><div class="v4-mission-node active-node"><text class="v4-node-k">CACHE</text><text class="v4-node-v">{{cacheState}}</text></div><div class="v4-mission-link"><div class="v4-flow-packet"></div></div><div class="v4-mission-node"><text class="v4-node-k">ROUTE</text><text class="v4-node-v">{{breadcrumbPoints}}</text></div><div class="v4-mission-link"><div class="v4-flow-packet fp2"></div></div><div class="v4-mission-node"><text class="v4-node-k">SAFE</text><text class="v4-node-v">{{anchorsCount}}</text></div></div>
      <text class="v4-stage-note">WEATHER {{weatherState}} • {{missionLabel}}</text>
    </div>

    <div if="{{advancedTitle == 'ENVIRONMENT RISK'}}" class="v4-stage v4-env-risk-stage">
      <div class="v4-risk-dial"><div class="v4-risk-ring"></div><text class="v4-risk-value">{{envRisk}}</text><text class="v4-risk-label">RISK</text></div>
      <div class="v4-side-stats"><div class="v4-stat"><text class="v4-k">TEMP</text><text class="v4-v">{{weatherTemp}}</text></div><div class="v4-stat"><text class="v4-k">UV</text><text class="v4-v">{{weatherUV}}</text></div><div class="v4-stat"><text class="v4-k">PRESSURE</text><text class="v4-v">{{pressureTrend}}</text></div></div>
    </div>

    <div if="{{advancedTitle == 'SENSOR SELF-TEST'}}" class="v4-stage v4-sensor-stage">
      <div class="v4-sensor-grid"><div class="v4-sensor-cell"><text class="v4-k">GPS</text><text class="v4-sensor-icon">◎</text><text class="v4-v">{{gpsState}}</text></div><div class="v4-sensor-cell"><text class="v4-k">HR</text><text class="v4-sensor-icon">♥</text><text class="v4-v">{{heartRate}}</text></div><div class="v4-sensor-cell"><text class="v4-k">BARO</text><text class="v4-sensor-icon">◌</text><text class="v4-v">{{pressure}}</text></div><div class="v4-sensor-cell"><text class="v4-k">COMP</text><text class="v4-sensor-icon">◇</text><text class="v4-v">{{headingNameText}}</text></div><div class="v4-sensor-cell"><text class="v4-k">MOTION</text><text class="v4-sensor-icon">⌁</text><text class="v4-v">{{impactButtonLabel}}</text></div><div class="v4-sensor-cell"><text class="v4-k">LINK</text><text class="v4-sensor-icon">↔</text><text class="v4-v">{{connectionState}}</text></div></div>
    </div>

    <div if="{{advancedTitle == 'MISSION TIMELINE PRO'}}" class="v4-stage v4-timeline-stage">
      <div class="v4-timeline-rail"><div class="v4-timeline-pulse"></div></div><div class="v4-timeline-items"><text class="v4-timeline-item">{{timeline1}}</text><text class="v4-timeline-item">{{timeline2}}</text><text class="v4-timeline-item">{{timeline3}}</text><text class="v4-timeline-item">{{timeline4}}</text></div>
    </div>

    <div if="{{advancedTitle == 'VOICE MACRO ENGINE'}}" class="v4-stage v4-voice-stage">
      <div class="voice-core v4-voice-core"><div if="{{powerProfile != 'ENDURANCE'}}" class="voice-ring vr1"></div><div if="{{powerProfile != 'ENDURANCE'}}" class="voice-ring vr2"></div><text class="voice-icon">MIC</text></div>
      <div class="v4-chip-grid"><text class="v4-chip">SAVE CAR</text><text class="v4-chip">RETURN</text><text class="v4-chip">WEATHER</text><text class="v4-chip">POWER</text></div>
    </div>

    <div if="{{advancedTitle == 'NOTIFICATION FILTER'}}" class="v4-stage v4-notify-stage">
      <div class="v4-alert-lane critical-lane"><text class="v4-alert-k">CRITICAL</text><div class="v4-alert-track"><div class="v4-alert-packet ap1"></div></div><text class="v4-alert-v">IMMEDIATE</text></div>
      <div class="v4-alert-lane warning-lane"><text class="v4-alert-k">WARNING</text><div class="v4-alert-track"><div class="v4-alert-packet ap2"></div></div><text class="v4-alert-v">FILTERED</text></div>
      <div class="v4-alert-lane info-lane"><text class="v4-alert-k">INFO</text><div class="v4-alert-track"><div class="v4-alert-packet ap3"></div></div><text class="v4-alert-v">QUIET</text></div>
    </div>

    <div if="{{advancedTitle == 'NEARBY DEVICE RECON'}}" class="v4-stage v4-bt-stage">
      <div class="network-radar v4-device-radar"><div class="radar-ring r1"></div><div class="radar-ring r2"></div><div class="radar-ring r3"></div><div if="{{powerProfile != 'ENDURANCE'}}" class="radar-sweep"></div><div class="radar-core"><text class="radar-value">{{btCount}}</text><text class="radar-label">BLE</text></div></div>
      <div class="v4-side-stats"><div class="v4-stat"><text class="v4-k">TRUSTED</text><text class="v4-v">{{btTrusted}}</text></div><div class="v4-stat"><text class="v4-k">UNKNOWN</text><text class="v4-v">{{btUnknown}}</text></div><div class="v4-stat"><text class="v4-k">MODE</text><text class="v4-v">PHONE</text></div></div>
    </div>

    <div if="{{advancedTitle == 'RUNNING ZONE HUD'}}" class="v4-stage v4-running-stage">
      <div class="sport-ring v4-run-ring"><div class="sport-ring-inner"><text class="sport-value">{{speedKmh}}</text><text class="sport-unit">KM/H</text></div></div>
      <div class="v4-side-stats"><div class="v4-stat"><text class="v4-k">HR</text><text class="v4-v">{{heartRate}}</text></div><div class="v4-stat"><text class="v4-k">ALT</text><text class="v4-v">{{altitude}}</text></div><div class="v4-stat"><text class="v4-k">ZONE</text><text class="v4-v">LIVE</text></div></div>
    </div>

    <div if="{{advancedTitle == 'SKY SCANNER PRO'}}" class="v4-stage v4-sky-stage">
      <div class="sky-orbit v4-sky-orbit"><div class="sky-core">SKY</div><div class="sky-ring sr1"></div><div class="sky-ring sr2"></div><div class="sky-dot sk1"></div><div class="sky-dot sk2"></div><div class="sky-dot sk3"></div></div>
      <div class="v4-side-stats"><div class="v4-stat"><text class="v4-k">SUN</text><text class="v4-v">{{weatherSun}}</text></div><div class="v4-stat"><text class="v4-k">WEATHER</text><text class="v4-v">{{weatherState}}</text></div><div class="v4-stat"><text class="v4-k">UV</text><text class="v4-v">{{weatherUV}}</text></div></div>
    </div>

    <div if="{{advancedTitle == 'NIGHT / STEALTH HUD'}}" class="v4-stage v4-stealth-stage">
      <div class="v4-stealth-core"><div class="v4-stealth-cross-h"></div><div class="v4-stealth-cross-v"></div><text class="v4-stealth-text">STEALTH</text></div>
      <div class="v4-side-stats"><div class="v4-stat"><text class="v4-k">POWER</text><text class="v4-v">{{powerProfile}}</text></div><div class="v4-stat"><text class="v4-k">ALERT</text><text class="v4-v">{{notificationMode}}</text></div><div class="v4-stat"><text class="v4-k">MOTION</text><text class="v4-v">LOW</text></div></div>
    </div>

    <div if="{{advancedTitle == 'RETURN DECISION HUD'}}" class="v4-stage v4-return-stage">
      <div class="v4-return-route"><div class="v4-route-base">BASE</div><div class="v4-route-line"><div class="v4-route-packet"></div></div><div class="v4-route-user">YOU</div></div>
      <div class="v4-return-stats"><div class="v4-stat"><text class="v4-k">ROUTE</text><text class="v4-v">{{routeSummary}}</text></div><div class="v4-stat"><text class="v4-k">POWER</text><text class="v4-v">{{watchBattery}}%</text></div><div class="v4-stat"><text class="v4-k">WEATHER</text><text class="v4-v">{{weatherState}}</text></div></div>
    </div>

    <div if="{{advancedTitle == 'FIELD QUICK PROFILES'}}" class="v4-stage v4-profile-stage">
      <div class="v4-profile-grid"><div class="v4-profile-card"><text class="v4-profile-icon">◉</text><text class="v4-profile-name">DAILY</text></div><div class="v4-profile-card"><text class="v4-profile-icon">△</text><text class="v4-profile-name">OUTDOOR</text></div><div class="v4-profile-card"><text class="v4-profile-icon">⌁</text><text class="v4-profile-name">RUNNING</text></div><div class="v4-profile-card"><text class="v4-profile-icon">◐</text><text class="v4-profile-name">NIGHT</text></div></div>
    </div>

    <div if="{{advancedTitle == 'IMPACT REVIEW'}}" class="v4-stage v4-impact-stage">
      <div class="v4-impact-core"><div class="v4-impact-h"></div><div class="v4-impact-v"></div><text class="v4-impact-text">IMPACT</text></div>
      <div class="v4-side-stats"><div class="v4-stat"><text class="v4-k">GPS</text><text class="v4-v">{{gpsState}}</text></div><div class="v4-stat"><text class="v4-k">HR</text><text class="v4-v">{{heartRate}}</text></div><div class="v4-stat"><text class="v4-k">ASSIST</text><text class="v4-v">{{impactButtonLabel}}</text></div></div>
    </div>

    <div if="{{advancedTitle == 'EMERGENCY ESCALATION'}}" class="v4-stage v4-escalation-stage">
      <div class="v4-escalation-ring"><div class="v4-escalation-inner"><text class="v4-escalation-title">L0–L3</text><text class="v4-escalation-state">{{advancedState}}</text></div></div>
      <div class="v4-level-grid"><text class="v4-level l0">L0 OK</text><text class="v4-level l1">L1 CHECK</text><text class="v4-level l2">L2 WARN</text><text class="v4-level l3">L3 SOS</text></div>
    </div>

    <div if="{{advancedTitle == 'FIELD CORE SETTINGS'}}" class="v4-stage v4-settings-stage">
      <div class="shield-core v4-settings-shield"><div if="{{powerProfile != 'ENDURANCE'}}" class="shield-ring"></div><text class="shield-text">LOCAL</text></div>
      <div class="v4-side-stats"><div class="v4-stat"><text class="v4-k">SCAN</text><text class="v4-v">{{wifiScanMode}}</text></div><div class="v4-stat"><text class="v4-k">ALERT</text><text class="v4-v">{{notificationMode}}</text></div><div class="v4-stat"><text class="v4-k">PRIVACY</text><text class="v4-v">LOCAL FIRST</text></div></div>
    </div>

    <!-- Recon / utility Advanced pages also get distinct visual identities. -->
    <div if="{{advancedTitle == 'BEST WI-FI'}}" class="v4-stage v4-bestwifi-stage"><div class="v4-score-ring"><text class="v4-score">BEST</text><text class="v4-score-name">{{wifiBest}}</text></div><div class="v4-side-stats"><div class="v4-stat"><text class="v4-k">OPEN</text><text class="v4-v">{{wifiOpen}}</text></div><div class="v4-stat"><text class="v4-k">SECURED</text><text class="v4-v">{{wifiSecured}}</text></div><div class="v4-stat"><text class="v4-k">AGE</text><text class="v4-v">{{wifiAge}}s</text></div></div></div>
    <div if="{{advancedTitle == 'CHANNELS'}}" class="v4-stage v4-channel-stage"><div class="v4-channel-bars"><div class="v4-channel-bar cb1"></div><div class="v4-channel-bar cb2"></div><div class="v4-channel-bar cb3"></div><div class="v4-channel-bar cb4"></div><div class="v4-channel-bar cb5"></div><div class="v4-channel-bar cb6"></div></div><text class="v4-stage-note">2.4 / 5 / 6 GHz LOAD</text></div>
    <div if="{{advancedTitle == 'SIGNAL HUNT'}}" class="v4-stage v4-signal-stage"><div class="eq-row v4-signal-eq"><div class="eq-bar eq1"></div><div class="eq-bar eq5"></div><div class="eq-bar eq2"></div><div class="eq-bar eq6"></div><div class="eq-bar eq3"></div><div class="eq-bar eq4"></div><div class="eq-bar eq7"></div></div><text class="v4-stage-note">RSSI TREND • NOT PHYSICAL DIRECTION</text></div>
    <div if="{{advancedTitle == 'DUPLICATE SSID'}}" class="v4-stage v4-duplicate-stage"><div class="v4-duplicate-node"><text class="v4-duplicate-icon">WIFI A</text></div><div class="v4-duplicate-link">?</div><div class="v4-duplicate-node"><text class="v4-duplicate-icon">WIFI B</text></div><text class="v4-stage-note">HEURISTIC ONLY • VERIFY BEFORE CONNECTING</text></div>
    <div if="{{advancedTitle == 'OUTDOOR SCAN'}}" class="v4-stage v4-outdoor-stage"><div class="network-radar v4-outdoor-radar"><div class="radar-ring r1"></div><div class="radar-ring r2"></div><div if="{{powerProfile != 'ENDURANCE'}}" class="radar-sweep"></div><div class="radar-core"><text class="radar-value">{{wifiCount}}</text><text class="radar-label">OUTDOOR</text></div></div><div class="v4-side-stats"><div class="v4-stat"><text class="v4-k">MODE</text><text class="v4-v">{{wifiScanMode}}</text></div><div class="v4-stat"><text class="v4-k">AGE</text><text class="v4-v">{{wifiAge}}s</text></div></div></div>
    <div if="{{advancedTitle == 'FIND PHONE'}}" class="v4-stage v4-findphone-stage"><div class="v4-phone-core"><div class="v4-phone-pulse pp1"></div><div class="v4-phone-pulse pp2"></div><text class="v4-phone-text">PHONE</text></div><text class="v4-stage-note">HAPTIC ALERT REQUEST</text></div>
    <div if="{{advancedTitle == 'DEVICE HISTORY'}}" class="v4-stage v4-history-stage"><div class="v4-history-line"><text class="v4-k">BLE HISTORY</text><text class="v4-v">{{btCount}}</text></div><div class="v4-history-line"><text class="v4-k">TRUSTED</text><text class="v4-v">{{btTrusted}}</text></div><div class="v4-history-line"><text class="v4-k">UNKNOWN</text><text class="v4-v">{{btUnknown}}</text></div></div>

    <div class="advanced-data-card"><text class="section-label">REAL / CACHED RESULT</text><text class="advanced-data">{{advancedData}}</text><text class="module-note">{{message}}</text></div>
    <div class="detail-extra"><input type="button" class="mini-extra active-state" value="REFRESH" onclick="advancedRefresh"/><input type="button" class="mini-extra" value="ADVANCED HUB" onclick="openAdvancedHub"/></div>
    <div if="{{advancedTitle == 'NIGHT / STEALTH HUD'}}" class="detail-extra"><input type="button" class="mini-extra" value="ENABLE" onclick="advStealthOn"/><input type="button" class="mini-extra" value="DISABLE" onclick="advStealthOff"/></div>
    <div if="{{advancedTitle == 'FIELD QUICK PROFILES'}}" class="profile-row"><input type="button" class="profile-btn" value="DAILY" onclick="advProfileDaily"/><input type="button" class="profile-btn" value="OUTDOOR" onclick="advProfileOutdoor"/><input type="button" class="profile-btn" value="RUNNING" onclick="advProfileRunning"/><input type="button" class="profile-btn" value="NIGHT" onclick="advProfileNight"/></div>
    <div if="{{advancedTitle == 'MISSION PACK'}}" class="detail-extra"><input type="button" class="mini-extra active-state" value="PREPARE PACK" onclick="advMissionPrepare"/><input type="button" class="mini-extra" value="MISSION START" onclick="advMissionStart"/></div><input if="{{advancedTitle == 'MISSION PACK'}}" type="button" class="wide-extra" value="MISSION STOP" onclick="advMissionStop"/>
    <div if="{{advancedTitle == 'LOST MODE PRO'}}" class="profile-row"><input type="button" class="profile-btn" value="FIND PHONE" onclick="advFindPhone"/><input type="button" class="profile-btn" value="RETURN" onclick="advLostReturn"/><input type="button" class="profile-btn danger-btn" value="SOS" onclick="advLostSos"/></div><div if="{{advancedTitle == 'LOST MODE PRO'}}" class="detail-extra"><input type="button" class="mini-extra" value="START LOST" onclick="advLostStart"/><input type="button" class="mini-extra" value="STOP LOST" onclick="advLostStop"/></div>
    <div if="{{advancedTitle == 'FIELD NOTIFICATION FILTER'}}" class="profile-row"><input type="button" class="profile-btn" value="FIELD" onclick="advNotifyField"/><input type="button" class="profile-btn" value="MISSION" onclick="advNotifyMission"/><input type="button" class="profile-btn" value="STEALTH" onclick="advNotifyStealth"/></div>
    <div if="{{advancedTitle == 'NEARBY DEVICE RECON'}}" class="detail-extra"><input type="button" class="mini-extra" value="SCAN" onclick="advBtScan"/><input type="button" class="mini-extra" value="HISTORY" onclick="advBtHistory"/></div>
    <div if="{{advancedTitle == 'EMERGENCY ESCALATION'}}" class="profile-row"><input type="button" class="profile-btn" value="L0" onclick="advEmergencyLevel0"/><input type="button" class="profile-btn" value="L1" onclick="advEmergencyLevel1"/><input type="button" class="profile-btn" value="L2" onclick="advEmergencyLevel2"/><input type="button" class="profile-btn danger-btn" value="L3" onclick="advEmergencyLevel3"/></div>
    <div if="{{advancedTitle == 'FIELD CORE SETTINGS'}}" class="profile-row"><input type="button" class="profile-btn" value="WIFI ACTIVE" onclick="advWifiModeActive"/><input type="button" class="profile-btn" value="BALANCED" onclick="advWifiModeBalanced"/><input type="button" class="profile-btn" value="SAVER" onclick="advWifiModeSaver"/></div>
    <div if="{{advancedTitle == 'FIELD CORE SETTINGS'}}" class="detail-extra"><input type="button" class="mini-extra" value="LOCATION ATTACH ON" onclick="advLocationAttachOn"/><input type="button" class="mini-extra" value="LOCATION ATTACH OFF" onclick="advLocationAttachOff"/></div>
    <div if="{{advancedTitle == 'FIELD CORE SETTINGS'}}" class="detail-extra"><input type="button" class="mini-extra" value="HAPTICS ON" onclick="advHapticsOn"/><input type="button" class="mini-extra" value="HAPTICS OFF" onclick="advHapticsOff"/></div>
  </div>

  <div if="{{view == 'emergencyConfirm'}}" class="emergency-screen emergency-v4 page-enter">
    <div class="system-status-strip emergency-strip"><div class="status-cell"><text class="status-dot danger-dot">●</text><text class="status-label">CORE</text></div><text class="danger-text">EMERGENCY</text><text class="status-label">GPS {{gpsState}}</text><text class="danger-text">SOS</text></div>
    <div class="emergency-dial"><div if="{{powerProfile != 'ENDURANCE'}}" class="emergency-pulse"></div><div class="emergency-dial-inner"><text class="emergency-title">CHECK USER</text><text class="countdown">{{emergencyCountdown}}</text><text class="emergency-sub">HIGH IMPACT / SOS</text></div></div>
    <text class="emergency-sub">SEND LOCATION WHEN TIMER ENDS</text>
    <input type="button" class="emergency-send" value="SEND NOW" onclick="sendEmergencyNow"/>
    <input type="button" class="emergency-cancel" value="I'M OK / CANCEL" onclick="cancelEmergency"/>
  </div>

  <div if="{{view == 'lightRed'}}" class="light-red"><text class="light-title">TACTICAL RED</text><text class="light-sub">FIELD LIGHT</text><input type="button" class="light-stop" value="STOP" onclick="stopLight"/></div>
  <div if="{{view == 'lightWhite'}}" class="light-white"><text class="light-title dark-text">WHITE LIGHT</text><text class="light-sub dark-text">FIELD LIGHT</text><input type="button" class="light-stop" value="STOP" onclick="stopLight"/></div>
  <div if="{{view == 'lightBlack'}}" class="light-black"><text class="light-title red-text">SOS</text><text class="light-sub red-text">FLASHING</text><input type="button" class="light-stop" value="STOP SOS" onclick="stopLight"/></div>
</stack>