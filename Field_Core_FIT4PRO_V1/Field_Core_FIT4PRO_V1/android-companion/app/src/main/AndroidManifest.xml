    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <application android:theme="@android:style/Theme.Material.NoActionBar" android:label="Field Core Companion" android:allowBackup="false">
        <meta-data android:name="com.huawei.hms.client.appid" android:value="appid=REPLACE_WITH_HUAWEI_APP_ID"/>
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
